<!-- Price Snippet -->
{%- if product.compare_at_price > product.price -%}
  <span class="price-compare" aria-label="Original price">
    <s>{{ product.compare_at_price | money }}</s>
  </span>
  <span class="price-sale" aria-label="Sale price">{{ product.price | money }}</span>
{%- else -%}
  <span class="price" aria-label="Price">{{ product.price | money }}</span>
{%- endif -%}

{%- if product.price_varies -%}
  <span class="price-from">From</span>
{%- endif -%}
