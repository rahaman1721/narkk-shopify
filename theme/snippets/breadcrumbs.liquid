<!-- Breadcrumbs Snippet -->
{%- unless template == 'index' -%}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Home</a>
  <span class="breadcrumbs-sep" aria-hidden="true"></span>

  {%- if template.name == 'product' -%}
    {%- if collection -%}
      <a href="{{ collection.url }}">{{ collection.title }}</a>
      <span class="breadcrumbs-sep" aria-hidden="true"></span>
    {%- endif -%}
    <span aria-current="page">{{ product.title }}</span>

  {%- elsif template.name == 'collection' -%}
    <span aria-current="page">{{ collection.title }}</span>

  {%- elsif template.name == 'page' -%}
    <span aria-current="page">{{ page.title }}</span>

  {%- elsif template.name == 'blog' -%}
    <span aria-current="page">{{ blog.title }}</span>

  {%- elsif template.name == 'article' -%}
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <span class="breadcrumbs-sep" aria-hidden="true"></span>
    <span aria-current="page">{{ article.title }}</span>

  {%- elsif template.name == 'cart' -%}
    <span aria-current="page">Cart</span>

  {%- elsif template.name == 'search' -%}
    <span aria-current="page">Search Results</span>

  {%- elsif template.name == 'customers/login' -%}
    <span aria-current="page">Sign In</span>

  {%- elsif template.name == 'customers/register' -%}
    <span aria-current="page">Create Account</span>

  {%- elsif template.name == 'customers/account' -%}
    <span aria-current="page">My Account</span>
  {%- endif -%}
</nav>
{%- endunless -%}
