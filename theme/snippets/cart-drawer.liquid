<!-- Cart Drawer Snippet -->
<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-label="Shopping cart" aria-hidden="true">
  <div class="cart-drawer-overlay" id="cartOverlay"></div>
  <div class="cart-drawer-panel">
    <!-- Header -->
    <div class="cart-drawer-hdr">
      <h2 class="cart-drawer-title">Your Cart</h2>
      <button class="cart-drawer-close" id="cartClose" aria-label="Close cart">
        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" fill="none" stroke-width="1.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Items -->
    <div class="cart-drawer-items" id="cartItems">
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <p>Your cart is empty.</p>
          <a href="/collections/tulai" class="cart-shop-link">Start Shopping</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-item" data-line="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-item-img">
              <img
                src="{{ item.image | image_url: width: 120 }}"
                alt="{{ item.title }}"
                width="80"
                height="80"
                loading="lazy"
              >
            </a>
            <div class="cart-item-info">
              <a href="{{ item.url }}" class="cart-item-title">{{ item.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <div class="cart-item-variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-item-price">{{ item.final_price | money }}</div>
              <div class="cart-item-qty-row">
                <button class="cart-qty-btn" onclick="updateCartItem({{ forloop.index }}, {{ item.quantity | minus: 1 }})" aria-label="Decrease quantity">&minus;</button>
                <span class="cart-item-qty">{{ item.quantity }}</span>
                <button class="cart-qty-btn" onclick="updateCartItem({{ forloop.index }}, {{ item.quantity | plus: 1 }})" aria-label="Increase quantity">+</button>
                <button class="cart-item-remove" onclick="removeCartItem({{ forloop.index }})" aria-label="Remove {{ item.title }}">Remove</button>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Footer -->
    <!-- Footer -->
    <div class="cart-drawer-ftr" id="cartFooter" style="{% if cart.item_count == 0 %}display: none;{% endif %}">
      <div class="cart-subtotal">
        <span>Subtotal</span>
        <span id="cartSubtotal">{{ cart.total_price | money }}</span>
      </div>
      <p class="cart-tax-note">Taxes and shipping calculated at checkout</p>
      <form action="/cart" method="post">
        <button type="submit" name="checkout" class="cart-checkout-btn">Proceed to Checkout</button>
      </form>
      <a href="/cart" class="cart-view-btn">View Full Cart</a>
    </div>
  </div>
</div>
