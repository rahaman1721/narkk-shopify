<!-- NEWSLETTER — Client essential: email capture / marketing -->
<style>
/* NEWSLETTER */
.nl { background:var(--sage); border-bottom:1px solid rgba(245,240,234,0.15); }
/* fallback ratio; header.liquid's script overrides this inline with the exact
   measured "LOOP" boundary so the divide matches the hero, split and starter. */
/* Full-bleed breakout — see hero-split.liquid for why. */
.nl-inner { width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); display:grid; grid-template-columns:var(--col-split); }
.nl-left { padding:72px 56px 80px; display:flex; flex-direction:column; justify-content:center; border-right:1px solid rgba(245,240,234,0.15); }
.nl-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:rgba(51,65,85,0.7); margin-bottom:20px; }
.nl-ey-line { width:24px; height:1px; background:rgba(51,65,85,0.4); flex-shrink:0; margin-left:-8px; }
.nl-title { font-size:var(--fs-h1); font-weight:200; letter-spacing:-0.5px; color:var(--slate); margin-bottom:16px; }
.nl-body { font-size:var(--fs-body); font-weight:300; color:rgba(51,65,85,0.85); line-height:1.75; max-width:440px; }
.nl-right { padding:72px 56px 80px; display:flex; flex-direction:column; justify-content:center; }
.nl-form { max-width:440px; margin-bottom:16px; }
.nl-row { display:flex; align-items:stretch; }
.nl-input { flex:1; background:rgba(245,240,234,0.3); border:1px solid rgba(245,240,234,0.2); padding:0 20px; font-size:var(--fs-body); font-weight:300; color:var(--slate); min-width:0; transition:background 0.2s; font-family:'Outfit',sans-serif; }
.nl-input::placeholder { color:rgba(51,65,85,0.5); }
.nl-input:focus { outline:none; background:rgba(245,240,234,0.5); border-color:rgba(245,240,234,0.4); }
.nl-btn { background:var(--slate); color:white; border:none; padding:0 24px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; cursor:pointer; display:flex; align-items:center; gap:8px; transition:background 0.15s; font-family:'Outfit',sans-serif; }
.nl-btn:hover { background:#1e293b; }
.nl-btn svg { width:12px; height:12px; stroke:white; fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; transition:transform 0.2s; }
.nl-btn:hover svg { transform:translateX(3px); }
.nl-success { margin-top:12px; font-size:var(--fs-sm); font-weight:300; color:var(--slate); display:flex; align-items:center; gap:6px; }
.nl-error { margin-top:12px; font-size:var(--fs-sm); font-weight:300; color:#dc2626; }
.nl-privacy { font-size:var(--fs-meta); font-weight:300; color:rgba(51,65,85,0.65); max-width:400px; margin-bottom:48px; }
.nl-privacy a { color:var(--slate); text-decoration:underline; text-underline-offset:2px; }
.nl-social { display:flex; align-items:center; gap:12px; }
.nl-social-label { font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:rgba(51,65,85,0.8); margin-right:4px; }
.nl-social-link { width:44px; height:44px; border-radius:50%; border:1px solid rgba(51,65,85,0.2); display:flex; align-items:center; justify-content:center; color:var(--slate); transition:all 0.15s; }
.nl-social-link:hover { background:var(--slate); color:white; border-color:var(--slate); }
.nl-social-link svg { width:20px; height:20px; stroke:currentColor; fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
@media(max-width:900px) { .nl-inner { grid-template-columns:1fr; } .nl-left { padding:48px 20px 40px; border-right:none; border-bottom:1px solid rgba(245,240,234,0.15); } .nl-right { padding:40px 20px 56px; } .nl-body { max-width:100%; } .nl-form { max-width:100%; } .nl-privacy { margin-bottom:32px; max-width:100%; } }
@media(max-width:400px) { .nl-row { flex-direction:column; gap:8px; } .nl-input { padding:14px 20px; } .nl-btn { padding:14px 24px; justify-content:center; } }
</style>

<section class="nl narkk-spine" id="newsletter">
  <div class="nl-inner">
    <div class="nl-left">
      <div class="nl-ey"><span class="nl-ey-line"></span>Join the Loop</div>
      <div class="nl-title">{{ section.settings.title | default: 'Be the first to know.' }}</div>
      <div class="nl-body">{{ section.settings.body | default: 'New drops, behind-the-scenes, community stories and early access - straight to your inbox.' }}</div>
    </div>
    <div class="nl-right">
      {% form 'customer', class: 'nl-form', id: 'nlForm' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="nl-row">
          <input
            type="email"
            name="contact[email]"
            id="nlEmail"
            placeholder="your@email.com"
            class="nl-input"
            required
            autocomplete="email"
          >
          <button type="submit" class="nl-btn" id="nlBtn">
            <span class="nl-btn-text">Subscribe</span>
            <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </button>
        </div>
        {%- if form.posted_successfully? -%}
          <div class="nl-success"> You're in &mdash; welcome to the Loop.</div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="nl-error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {% endform %}
      <div class="nl-privacy">By subscribing you agree to our <a href="/pages/privacy-policy">Privacy Policy</a>. Unsubscribe anytime.</div>
      <div class="nl-social">
        <span class="nl-social-label">Follow us</span>
        <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/narkkloop?igsh=NXo4em56b3k4Z3Qy' }}" class="nl-social-link" target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="{{ section.settings.reddit_url | default: 'https://www.reddit.com/r/Narkkloop/s/94Mec6cAYf' }}" class="nl-social-link" target="_blank" rel="noopener" aria-label="Reddit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="13.5" r="7" />
            <path d="M11 7.2 9.3 3.4l3.1-.8 1 1.7" />
            <circle cx="9.3" cy="3.4" r="1.1" fill="currentColor" stroke="none" />
            <circle cx="9.3" cy="12.2" r="1" fill="currentColor" stroke="none" />
            <circle cx="14.7" cy="12.2" r="1" fill="currentColor" stroke="none" />
            <path d="M9 16.3c.8.9 1.9 1.4 3 1.4s2.2-.5 3-1.4" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "presets": [{ "name": "Newsletter" }],
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Be the first to know." },
    { "type": "textarea", "id": "body", "label": "Description" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "reddit_url", "label": "Reddit URL" }
  ]
}
{% endschema %}

