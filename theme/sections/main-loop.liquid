.main-img{flex:1;aspect-ratio:1/1;border:1px solid var(--border);overflow:hidden;background:var(--cream-d);}
.main-img img{width:100%;height:100%;object-fit:contain;display:block;}
.buy{padding:56px 56px 48px;display:flex;flex-direction:column;}
.buy-ey{display:flex;align-items:center;gap:10px;font-size:var(--fs-lbl);font-weight:300;letter-spacing:2.5px;text-transform:uppercase;color:var(--coral);margin-bottom:18px;}
.buy-ey-line{width:24px;height:1px;background:var(--coral);flex-shrink:0;}
.buy-title{font-size:var(--fs-disp);font-weight:200;letter-spacing:-2px;line-height:1;color:var(--slate);margin-bottom:16px;}
.buy-lede{font-size:var(--fs-body);font-weight:300;color:var(--slate-l);line-height:1.85;max-width:420px;margin-bottom:26px;}
.buy-price-row{display:flex;align-items:baseline;gap:12px;padding-bottom:24px;border-bottom:1px solid var(--border);margin-bottom:26px;}
