.buy-price-note{font-size:var(--fs-meta);font-weight:300;color:var(--sage);}
.field-lbl{display:flex;align-items:center;justify-content:space-between;font-size:var(--fs-lbl);font-weight:400;letter-spacing:2px;text-transform:uppercase;color:var(--slate);margin-bottom:12px;}
.field-lbl .field-meta{font-weight:300;letter-spacing:1.5px;color:var(--sage);}
.sizes{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:28px;}
.sizeopt{border:1px solid var(--border-m);background:transparent;border-radius:3px;padding:12px 8px;cursor:pointer;text-align:center;transition:border-color 0.15s,background 0.15s;font-family:'Outfit',sans-serif;}
.sizeopt:hover{background:var(--cream-d);}
.sizeopt-name{display:block;font-size:var(--fs-sm);font-weight:300;color:var(--slate);}
.sizeopt-price{display:block;font-size:var(--fs-micro);font-weight:300;color:var(--sage);margin-top:3px;}
.sizeopt.on{border-color:var(--coral);background:var(--clay-tint);}
