.qty-row{display:flex;align-items:center;gap:16px;margin-bottom:14px;}
.stepper{display:flex;align-items:center;border:1px solid var(--border-m);border-radius:3px;overflow:hidden;}
.stepper button{width:42px;height:46px;border:none;background:transparent;font-size:18px;font-weight:300;color:var(--slate);cursor:pointer;font-family:'Outfit',sans-serif;transition:background 0.12s;}
.stepper button:hover{background:var(--cream-d);}
.stepper .q{width:44px;text-align:center;font-size:var(--fs-body);font-weight:400;color:var(--slate);}
.buybtn{flex:1;height:48px;border:none;border-radius:3px;background:var(--coral);color:#fff;font-family:'Outfit',sans-serif;font-size:var(--fs-lbl);font-weight:400;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:opacity 0.15s,background 0.2s;}
.buybtn:hover{opacity:0.88;}
.buybtn.done{background:var(--teal);}
.re-row{display:flex;gap:22px;margin-top:22px;padding-top:22px;border-top:1px solid var(--border);flex-wrap:wrap;}
.re-item{display:flex;align-items:center;gap:8px;font-size:var(--fs-meta);font-weight:300;color:var(--slate-l);}
.re-item svg{width:15px;height:15px;stroke:var(--coral);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}
.acc-sec{border-bottom:1px solid var(--border);background:var(--cream-d);}
.acc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--border);border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin-top:36px;}
.acc{background:var(--cream-d);padding:0;display:flex;flex-direction:column;transition:background 0.15s;}
.acc.on{background:var(--cream);}
.acc-img{aspect-ratio:1/1;overflow:hidden;background:var(--cream);}
.acc-img img{width:100%;height:100%;object-fit:contain;display:block;}
.acc-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:var(--fs-lbl);font-weight:300;letter-spacing:1.5px;text-transform:uppercase;color:var(--sage);}
.acc-body{padding:16px 18px 18px;display:flex;flex-direction:column;flex:1;}
.acc-name{font-size:var(--fs-body);font-weight:300;color:var(--slate);margin-bottom:3px;}
.acc-subl{font-size:var(--fs-meta);font-weight:300;color:var(--sage);margin-bottom:14px;flex:1;}
.acc-foot{display:flex;align-items:center;justify-content:space-between;}
.acc-price{font-size:var(--fs-body);font-weight:300;color:var(--slate);}
.acc-btn{font-family:'Outfit',sans-serif;font-size:var(--fs-micro);font-weight:400;letter-spacing:1.5px;text-transform:uppercase;color:var(--coral);background:transparent;border:1px solid var(--clay-line,rgba(193,107,69,0.32));border-radius:3px;padding:7px 14px;cursor:pointer;transition:all 0.15s;}
</style>

  {%- assign loop_blog = blogs[section.settings.blog_top] -%}
  {%- assign loop_articles = loop_blog.articles -%}
  {%- assign loop_limit = section.settings.blog_top_limit | default: 6 -%}
  {%- assign loop_total_count = loop_blog.articles_count | default: 0 -%}

  <!-- FILTER STRIP (sticky scoped to From the Loop section only) -->
  <div class="lp-strip-scope">
  <div class="lp-strip" id="lp-filter-strip">
    <span class="lp-tab active" data-tag="all">All</span><span class="lp-tab" data-tag="il">Intentional Living</span><span class="lp-tab" data-tag="do">Declutter &amp; Organise</span><span class="lp-tab" data-tag="cm">Craft &amp; Material</span><span class="lp-tab" data-tag="ss">Stories That Stayed</span><span class="lp-tab" data-tag="iu">In Use</span>
    <span class="lp-count" id="lp-count">{{ loop_total_count }} articles</span>
  </div>

  <!-- FROM THE LOOP -->
  <div class="lp-sec-head">
    <div>
      <div class="lp-sec-ey"><span class="lp-sec-ey-line"></span>Living with Intentions</div>
      <div class="lp-sec-title">From the Loop</div>
    </div>
    <a href="{{ loop_blog.url | default: '#' }}" class="lp-sec-link">See all articles &rarr;</a>
  </div>

  <!-- MASONRY GRID &mdash; bordered container -->
  <div class="lp-masonry-wrap">
    <div class="lp-masonry" id="lp-article-grid">

      {%- if loop_articles.size > 0 -%}
        {%- for article in loop_articles limit: loop_limit -%}
          {%- assign tag_lower = article.tags.first | downcase -%}
          {%- case tag_lower -%}
            {%- when 'intentional living' -%}{%- assign tag_slug = 'il' -%}
            {%- when 'declutter & organise' or 'declutter and organise' -%}{%- assign tag_slug = 'do' -%}
            {%- when 'craft & material' or 'craft and material' -%}{%- assign tag_slug = 'cm' -%}
            {%- when 'stories that stayed' -%}{%- assign tag_slug = 'ss' -%}
            {%- when 'in use' -%}{%- assign tag_slug = 'iu' -%}
            {%- else -%}{%- assign tag_slug = 'il' -%}
          {%- endcase -%}
          <a href="{{ article.url }}" class="lp-m-card {% if forloop.first %}hero{% endif %}" data-tag="{{ tag_slug }}">
            <div class="lp-m-img">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.title | escape }}" loading="lazy">
              {%- else -%}
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; color:var(--text-secondary); font-size:11px;">No image</div>
              {%- endif -%}
              <span class="lp-m-tag lp-tag-{{ tag_slug }}">{{ article.tags.first | default: 'Article' }}</span>
            </div>
            <div class="lp-m-body">
              <div class="lp-m-meta"><span class="lp-m-meta-tag">{{ article.tags.first | default: 'Article' }}</span><span class="lp-m-dot"></span><span class="lp-m-time">{{ article.published_at | time_tag: '%b %-d, %Y' }}</span></div>
              <div class="lp-m-title">{{ article.title }}</div>
              <div class="lp-m-excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</div>
              <div class="lp-m-footer">
                <div class="lp-m-author">
                  <div class="lp-avatar">{{ article.author | slice: 0 }}</div>
                  <span>{{ article.author | default: 'narkk Loop' }}</span>
                </div>
                <span class="lp-m-read">Read &rarr;</span>
              </div>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- Static fallback cards — mirrors the standalone site's "From the Loop" content exactly -->
        <a href="#" class="lp-m-card hero" data-tag="il">
          <div class="lp-m-img">
            <img src="{{ 'loop-article-1-intentional-living.jpg' | asset_url }}" alt="Move beyond trends. Design a space that outlives the season." loading="lazy">
          </div>
          <div class="lp-m-body">
            <div class="lp-m-meta"><span class="lp-m-meta-tag">Intentional Living</span><span class="lp-m-dot"></span><span class="lp-m-time">6 min read</span></div>
            <div class="lp-m-title">Move beyond trends. Design a space that outlives the season.</div>
            <div class="lp-m-excerpt">The homes that age well aren't the ones that chased the moment. They started with one question — what do I actually need?</div>
            <div class="lp-m-footer">
              <div class="lp-m-author"><div class="lp-avatar">NL</div><span>narkk Loop</span></div>
              <span class="lp-m-read">Read &rarr;</span>
            </div>
          </div>
        </a>
        <a href="#" class="lp-m-card" data-tag="do">
          <div class="lp-m-img">
            <img src="{{ 'loop-article-2-declutter.jpg' | asset_url }}" alt="The one rule that makes decluttering actually stick." loading="lazy">
          </div>
          <div class="lp-m-body">
            <div class="lp-m-meta"><span class="lp-m-meta-tag">Declutter &amp; Organise</span><span class="lp-m-dot"></span><span class="lp-m-time">4 min read</span></div>
            <div class="lp-m-title">The one rule that makes decluttering actually stick.</div>
            <div class="lp-m-excerpt">It's not about getting rid of things. It's about understanding why you kept them.</div>
            <div class="lp-m-footer">
              <div class="lp-m-author"><div class="lp-avatar">NL</div><span>narkk Loop</span></div>
              <span class="lp-m-read">Read &rarr;</span>
            </div>
          </div>
        </a>
        <a href="#" class="lp-m-card" data-tag="cm">
          <div class="lp-m-img">
            <img src="{{ 'loop-article-3-craft-material.jpg' | asset_url }}" alt="Why birch plywood outlasts MDF by a decade." loading="lazy">
          </div>
          <div class="lp-m-body">
            <div class="lp-m-meta"><span class="lp-m-meta-tag">Craft &amp; Material</span><span class="lp-m-dot"></span><span class="lp-m-time">5 min read</span></div>
            <div class="lp-m-title">Why birch plywood outlasts MDF by a decade.</div>
            <div class="lp-m-excerpt">The material decision is made before the product is designed.</div>
            <div class="lp-m-footer">
              <div class="lp-m-author"><div class="lp-avatar">N</div><span>Niranjan</span></div>
              <span class="lp-m-read">Read &rarr;</span>
            </div>
          </div>
        </a>
        <a href="#" class="lp-m-card" data-tag="ss">
          <div class="lp-m-img">
            <img src="{{ 'loop-article-4-stories-stayed.jpg' | asset_url }}" alt="My grandfather's chair is still in our living room." loading="lazy">
          </div>
          <div class="lp-m-body">
            <div class="lp-m-meta"><span class="lp-m-meta-tag">Stories That Stayed</span><span class="lp-m-dot"></span><span class="lp-m-time">3 min read</span></div>
            <div class="lp-m-title">My grandfather's chair is still in our living room.</div>
            <div class="lp-m-excerpt">A piece of furniture from 1971. Still standing.</div>
            <div class="lp-m-footer">
              <div class="lp-m-author"><div class="lp-avatar">PK</div><span>Community</span></div>
              <span class="lp-m-read">Read &rarr;</span>
            </div>
          </div>
        </a>
        <a href="#" class="lp-m-card" data-tag="iu">
          <div class="lp-m-img">
            <img src="{{ 'loop-article-5-in-use.jpg' | asset_url }}" alt="How a 550mm board changed our entryway." loading="lazy">
          </div>
          <div class="lp-m-body">
            <div class="lp-m-meta"><span class="lp-m-meta-tag">In Use</span><span class="lp-m-dot"></span><span class="lp-m-time">2 min read</span></div>
            <div class="lp-m-title">How a 550mm board changed our entryway.</div>
            <div class="lp-m-excerpt">Keys, bag, jacket — and somehow everything else.</div>
            <div class="lp-m-footer">
              <div class="lp-m-author"><div class="lp-avatar">SR</div><span>Community</span></div>
              <span class="lp-m-read">Read &rarr;</span>
            </div>
          </div>
        </a>
        <a href="#" class="lp-m-card" data-tag="il">
          <div class="lp-m-img">
            <img src="{{ 'loop-article-6-il-question.jpg' | asset_url }}" alt="The question to ask before buying anything for your home." loading="lazy">
          </div>
          <div class="lp-m-body">
            <div class="lp-m-meta"><span class="lp-m-meta-tag">Intentional Living</span><span class="lp-m-dot"></span><span class="lp-m-time">7 min read</span></div>
            <div class="lp-m-title">The question to ask before buying anything for your home.</div>
            <div class="lp-m-excerpt">Not "do I like it?" — but "where will this be in five years?"</div>
            <div class="lp-m-footer">
              <div class="lp-m-author"><div class="lp-avatar">NL</div><span>narkk Loop</span></div>
              <span class="lp-m-read">Read &rarr;</span>
            </div>
          </div>
        </a>
      {%- endif -%}

    </div>
  </div>
  <div class="lp-see-more"><a href="#" class="lp-see-more-btn">See all articles &rarr;</a></div>
  </div>

  <!-- FIND YOUR COMMUNITY &mdash; teal, 1:2 ratio feel -->
  <section class="lp-community">
