<style>
/* 
   LOOP PAGE
 */

/* filter strip */
.lp-strip-scope { position:relative; }
.lp-strip { position:sticky; top:var(--nav-h); z-index:100; background:rgba(245,240,234,0.97); backdrop-filter:blur(12px); border-bottom:1px solid var(--border); display:flex; align-items:center; padding:0 56px; height:48px; overflow-x:auto; scrollbar-width:none; }
.lp-strip::-webkit-scrollbar { display:none; }
.lp-tab { font-size:var(--fs-lbl); font-weight:300; letter-spacing:1.8px; text-transform:uppercase; color:var(--sage); padding:0 20px; height:100%; display:flex; align-items:center; border-right:1px solid var(--border); cursor:pointer; white-space:nowrap; transition:color 0.15s; position:relative; }
.lp-tab::after { content:''; position:absolute; bottom:0; left:0; right:0; height:2px; background:var(--teal); transform:scaleX(0); transition:transform 0.2s; }
.lp-tab:hover { color:var(--slate); }
.lp-tab.active { color:var(--teal); }
.lp-tab.active::after { transform:scaleX(1); }
.lp-count { margin-left:auto; padding-left:20px; font-size:var(--fs-lbl); font-weight:300; color:var(--sage); border-left:1px solid var(--border); height:100%; display:flex; align-items:center; white-space:nowrap; }
@media(max-width:768px) { .lp-strip { padding:0 20px; } .lp-count { display:none; } }

/* section heads */
.lp-sec-head { padding:48px 56px 32px; display:flex; align-items:flex-end; justify-content:space-between; background:var(--cream); }
.lp-sec-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--teal); margin-bottom:8px; }
.lp-sec-ey-line { width:24px; height:1px; background:var(--teal); flex-shrink:0; }
.lp-sec-title { font-size:var(--fs-h2); font-weight:200; letter-spacing:-0.5px; color:var(--slate); }
.lp-sec-link { font-size:var(--fs-lbl); font-weight:300; letter-spacing:1.5px; text-transform:uppercase; color:var(--teal); text-decoration:none; border-bottom:1px solid rgba(74,155,142,0.3); padding-bottom:1px; white-space:nowrap; }
@media(max-width:768px) { .lp-sec-head { padding:32px 20px; flex-direction:column; align-items:flex-start; gap:12px; } }

/* masonry article grid — standalone grid approach */
.lp-masonry-wrap { background:var(--cream); border-bottom:1px solid var(--border); overflow:hidden; }
.lp-masonry-wrap { margin:0 !important; padding:0 !important; }
.lp-masonry { display:grid; grid-template-columns:repeat(3,1fr); grid-gap:0 !important; gap:0 !important; border-top:1px solid var(--border); margin:0 !important; margin-right:-1px !important; padding:0 !important; }
.lp-m-card { background:var(--cream); border-right:1px solid var(--border); border-bottom:1px solid var(--border); margin:0 !important; overflow:hidden; cursor:pointer; transition:background 0.15s; display:flex; flex-direction:column; color:inherit; text-decoration:none; }
.lp-m-card:hover { background:var(--cream-d); }
.lp-m-img { width:100%; overflow:hidden; background:var(--cream-d); position:relative; aspect-ratio:4/3; }
.lp-m-img img { width:100%; height:100%; display:block; object-fit:cover; transition:transform 0.4s; }
.lp-m-card:hover .lp-m-img img { transform:scale(1.03); }
/* hide floating image tag badges — category shown in body meta row */
.lp-m-tag { display:none; }
.lp-m-body { padding:18px 20px 20px; display:flex; flex-direction:column; flex:1; }
.lp-m-meta { display:flex; align-items:center; gap:7px; margin-bottom:8px; flex-wrap:nowrap; overflow:hidden; }
.lp-m-meta-tag { font-size:var(--fs-micro); font-weight:300; letter-spacing:1.5px; text-transform:uppercase; color:var(--teal); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.lp-m-dot { width:3px; height:3px; border-radius:50%; background:var(--border-m); flex-shrink:0; }
.lp-m-time { font-size:var(--fs-lbl); font-weight:300; color:var(--sage); }
.lp-m-title { font-size:var(--fs-body); font-weight:300; color:var(--slate); line-height:1.45; margin-bottom:8px; }
.lp-m-card.hero .lp-m-title { font-size:clamp(15px, 3.5vw, var(--fs-h3)); }
.lp-m-excerpt { font-size:var(--fs-sm); font-weight:300; color:var(--slate-l); line-height:1.65; margin-bottom:14px; }
.lp-m-footer { display:flex; align-items:center; justify-content:space-between; padding-top:12px; margin-top:auto; border-top:1px solid var(--border); }
.lp-m-author { display:flex; align-items:center; gap:7px; }
.lp-avatar { width:22px; height:22px; border-radius:50%; background:var(--cream-d); display:flex; align-items:center; justify-content:center; font-size:8px; font-weight:400; color:var(--slate-l); flex-shrink:0; }
.lp-m-author span { font-size:var(--fs-meta); font-weight:300; color:var(--slate-l); }
.lp-m-read { font-size:var(--fs-micro); font-weight:300; letter-spacing:1.5px; text-transform:uppercase; color:var(--teal); border-bottom:1px solid rgba(74,155,142,0.3); padding-bottom:1px; }
.lp-see-more { padding:24px 56px; background:var(--cream); border-bottom:1px solid var(--border); display:flex; justify-content:center; }
.lp-see-more-btn { font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:var(--teal); text-decoration:none; border:1px solid rgba(74,155,142,0.35); padding:12px 28px; border-radius:3px; transition:background 0.15s; }
.lp-see-more-btn:hover { background:rgba(74,155,142,0.06); }
@media(max-width:900px) { .lp-masonry { grid-template-columns:repeat(2,1fr); } }
@media(max-width:640px) {
  .lp-masonry-wrap { padding: 0 16px; background: var(--cream); border-bottom: none; }
  .lp-masonry { grid-template-columns: 1fr; border-top: 1px solid var(--border); border-left: 1px solid var(--border); margin-right: 0; margin-bottom: 16px; }
  .lp-see-more { padding: 0 16px 20px; }
  .lp-m-card { flex-direction:column; border-right: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .lp-m-card .lp-m-img { width:100%; aspect-ratio:4/3; height:auto; }
  .lp-m-body { padding: 20px; }
  .lp-m-meta { margin-bottom: 8px; }
  .lp-m-meta-tag { font-size: 10px; }
  .lp-m-time { font-size: 10px; }
  .lp-m-title { font-size: 18px; line-height: 1.4; margin-bottom: 8px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
  .lp-m-card.hero .lp-m-title { font-size: 18px; }
  .lp-m-excerpt { display:none; }
  .lp-m-footer { padding-top: 12px; }
}

/* community &mdash; teal, shrunk 1:2 ratio feel */
.lp-community { background:var(--teal); border-bottom:1px solid rgba(255,255,255,0.12); }
.lp-comm-head { padding:36px 56px 28px; }
.lp-comm-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:rgba(245,240,234,0.65); margin-bottom:10px; }
.lp-comm-ey-line { width:24px; height:1px; background:rgba(245,240,234,0.4); flex-shrink:0; }
.lp-comm-title { font-size:var(--fs-h2); font-weight:200; letter-spacing:-0.5px; color:white; margin-bottom:8px; }
.lp-comm-sub { font-size:var(--fs-sm); font-weight:300; color:rgba(245,240,234,0.75); max-width:480px; line-height:1.7; }
.lp-channels { display:grid; grid-template-columns:repeat(3,1fr); border-top:1px solid rgba(255,255,255,0.12); }
.lp-channel { padding:28px 32px 32px; border-right:1px solid rgba(255,255,255,0.12); display:flex; flex-direction:column; text-decoration:none; transition:background 0.15s; cursor:pointer; }
.lp-channel:last-child { border-right:none; }
.lp-channel:hover { background:rgba(255,255,255,0.06); }
.lp-ch-icon { width:32px; height:32px; margin-bottom:18px; }
.lp-ch-icon svg { width:100%; height:100%; stroke:rgba(245,240,234,0.7); fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
.lp-ch-name { font-size:var(--fs-h3); font-weight:200; color:white; margin-bottom:5px; }
.lp-ch-handle { font-size:var(--fs-meta); font-weight:300; color:rgba(245,240,234,0.5); margin-bottom:12px; }
.lp-ch-desc { font-size:var(--fs-sm); font-weight:300; color:rgba(245,240,234,0.7); line-height:1.65; margin-bottom:20px; flex:1; }
.lp-ch-cta { font-size:var(--fs-lbl); font-weight:300; letter-spacing:1.8px; text-transform:uppercase; color:rgba(245,240,234,0.85); border-bottom:1px solid rgba(245,240,234,0.3); padding-bottom:1px; width:fit-content; }
.lp-ch-soon { opacity:0.6; cursor:default; }
.lp-ch-cta-dim { color:rgba(245,240,234,0.35); border-color:rgba(245,240,234,0.15); }

/* Swipe dots hidden */
.lp-ch-dots { display:none !important; }

@media(max-width:900px) {
  .lp-comm-head { padding:28px 20px 16px; }
  /* Single column — each card is a square, stacked one by one */
  .lp-channels {
    display:flex;
    flex-direction:column;
    border-top:1px solid rgba(255,255,255,0.12);
  }
  .lp-channel {
    width:100%;
    border-right:none;
    border-bottom:1px solid rgba(255,255,255,0.12);
    padding:28px 24px;
    display:flex;
    flex-direction:column;
    justify-content:flex-start; /* keep items grouped at top */
    overflow:hidden;
  }
  .lp-channel:last-child { border-bottom:none; }
  .lp-ch-desc {
    flex:none; /* overrides flex:1 from desktop so CTA is not pushed to the bottom */
    margin-bottom: 24px;
    overflow:hidden;
    display:-webkit-box;
    -webkit-line-clamp:4;
    -webkit-box-orient:vertical;
  }
}

/* chapter break &mdash; beige */
.lp-chapter { background:var(--cream-d); padding:56px; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
.lp-ch-label { font-size:var(--fs-micro); font-weight:300; letter-spacing:3px; text-transform:uppercase; color:var(--sage); margin-bottom:12px; }
.lp-ch-title { font-size:var(--fs-h1); font-weight:200; letter-spacing:-1px; color:var(--teal); line-height:1.1; margin-bottom:12px; }
.lp-ch-sub { font-size:var(--fs-body); font-weight:300; color:var(--slate-l); max-width:440px; line-height:1.75; }
@media(max-width:768px) { .lp-chapter { padding:32px 20px; } }

/* inner loop &mdash; beige background */
.lp-inner { background:var(--cream-d); }
.lp-inner-intro { padding:64px 56px 56px; border-bottom:1px solid var(--border); max-width:700px; }
.lp-inner-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--teal); margin-bottom:0; }
.lp-inner-ey-line { width:24px; height:1px; background:var(--teal); flex-shrink:0; }
.lp-inner-title { font-size:var(--fs-disp); font-weight:200; letter-spacing:-2px; line-height:1; color:var(--teal); margin-top:24px; margin-bottom:28px; }
.lp-inner-desc { font-size:var(--fs-body); font-weight:300; color:var(--slate-l); line-height:1.9; }
/* person cards grid */
.lp-inner-who-section { padding:52px 56px; border-bottom:1px solid var(--border); }
.lp-inner-who-lbl { font-size:var(--fs-micro); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--sage); margin-bottom:28px; }
.lp-person-grid { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; }
.lp-person-card { background:var(--cream); border:1px solid var(--border-m); border-radius:4px; padding:24px 20px; }
.lp-person-num { font-size:var(--fs-micro); font-weight:300; letter-spacing:1px; color:var(--teal); margin-bottom:12px; opacity:0.7; }
.lp-person-name { font-size:var(--fs-body); font-weight:300; color:var(--slate); margin-bottom:8px; line-height:1.3; }
.lp-person-desc { font-size:var(--fs-sm); font-weight:300; color:var(--slate-l); line-height:1.6; }
.lp-inner-cta-row { padding:52px 56px; display:flex; align-items:center; justify-content:space-between; gap:40px; border-top:1px solid var(--border); }
.lp-inner-cta-title { font-size:var(--fs-h2); font-weight:200; color:var(--slate); margin-bottom:8px; letter-spacing:-0.3px; }
.lp-inner-cta-sub { font-size:var(--fs-sm); font-weight:300; color:var(--slate-l); line-height:1.6; max-width:400px; }
.lp-inner-cta-btn { font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; background:var(--teal); color:white; border:none; padding:14px 28px; border-radius:3px; cursor:pointer; text-decoration:none; white-space:nowrap; transition:opacity 0.15s; flex-shrink:0; }
.lp-inner-cta-btn:hover { opacity:0.85; }
@media(max-width:900px) { .lp-person-grid { grid-template-columns:repeat(2,1fr); } }
@media(max-width:768px) { 
  .lp-inner-intro { padding:32px 20px 28px; } 
  .lp-inner-title { font-size:clamp(32px,10vw,52px); letter-spacing:-1px; margin-top:16px; margin-bottom:20px; }
  .lp-inner-desc { font-size:var(--fs-sm); line-height:1.8; }
  .lp-inner-who-section { padding:28px 20px; } 
  .lp-inner-cta-row { flex-direction:column; align-items:flex-start; padding:28px 20px; } 
  .lp-inner-cta-title { font-size:clamp(22px,6vw,32px); }
  .lp-person-grid { grid-template-columns:1fr; } 
}

/* write for loop &mdash; pre-footer, content left, image right */
.lp-writers { background:var(--slate); border-top:1px solid rgba(143,168,168,0.15); }
.lp-writers-inner { display:grid; grid-template-columns:1fr 1fr; min-height:400px; }
.lp-writers-left { padding:64px 56px; display:flex; flex-direction:column; justify-content:center; border-right:1px solid rgba(143,168,168,0.15); }
.lp-writers-right { overflow:hidden; background:rgba(255,255,255,0.04); }
.lp-writers-right img { width:100%; height:100%; object-fit:contain; display:block; }
.lp-writers-ey { font-size:var(--fs-micro); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--slate); margin-bottom:16px; }
.lp-writers-title { font-size:clamp(22px,2.5vw,32px); font-weight:200; color:var(--slate); margin-bottom:16px; line-height:1.2; }
.lp-writers-desc { font-size:var(--fs-sm); font-weight:300; color:rgba(51,65,85,0.75); line-height:1.75; max-width:440px; margin-bottom:36px; flex:1; }
.lp-writers-btn { display:inline-flex; align-items:center; gap:10px; font-family:inherit; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:var(--cream); text-decoration:none; background:var(--slate); border:1px solid rgba(51,65,85,0.8); padding:14px 28px; border-radius:3px; white-space:nowrap; width:fit-content; cursor:pointer; transition:opacity 0.15s; }
.lp-writers-btn:hover { opacity:0.85; }
@media(max-width:768px) { 
  .lp-writers-inner { grid-template-columns:1fr; } 
  .lp-writers-left { padding:32px 20px 36px; border-right:none; border-bottom:1px solid rgba(143,168,168,0.15); } 
  .lp-writers-right { aspect-ratio:4/3; min-height:unset; } 
  .lp-writers-title { font-size:clamp(22px,6vw,32px); }
}

/* end-of-loop centered divider */
.lp-loop-endline { display:flex; align-items:center; width:100%; max-width:100%; padding:44px 56px; background:var(--cream); overflow:hidden; box-sizing:border-box; }
.lp-loop-endline-bar { flex:1 1 0; min-width:0; height:1px; background:var(--border); }
.lp-loop-endline-word { flex:0 0 auto; padding:0 22px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:3px; text-transform:uppercase; color:var(--sage); white-space:nowrap; }
@media(max-width:500px) { .lp-loop-endline { padding:32px 20px; } .lp-loop-endline-word { padding:0 14px; letter-spacing:2.5px; } }

/* 
   PHILOSOPHY PAGE
 */

/* founder letter */
.ph-founder { position:relative; width:100%; min-height:90vh; overflow:hidden; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
.ph-founder-img { position:absolute; inset:0; width:100%; height:100%; object-fit:contain; object-position:right center; display:block; }
.ph-founder-grad { position:absolute; inset:0; background:linear-gradient(to right, rgba(245,240,234,0.97) 0%, rgba(245,240,234,0.93) 28%, rgba(245,240,234,0.6) 48%, rgba(245,240,234,0) 65%); }
.ph-founder-content { position:relative; z-index:2; max-width:520px; padding:72px 0 72px 56px; }
.ph-founder-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--sage); margin-bottom:28px; }
.ph-founder-ey-line { width:24px; height:1px; background:var(--sage); flex-shrink:0; }
.ph-founder-sal { font-size:var(--fs-sm); font-weight:300; color:var(--coral); letter-spacing:0.5px; margin-bottom:20px; }
.ph-founder-body { font-size:var(--fs-body); font-weight:300; color:var(--slate); line-height:1.9; margin-bottom:16px; max-width:440px; }
.ph-founder-more { display:none; }
.ph-founder-more.open { display:block; }
.ph-founder-more p { font-size:var(--fs-body); font-weight:300; color:var(--slate); line-height:1.9; margin-bottom:16px; max-width:440px; }
.ph-founder-toggle { display:inline-flex; align-items:center; gap:8px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:var(--coral); cursor:pointer; border-bottom:1px solid rgba(193,107,69,0.3); padding-bottom:2px; margin-top:8px; background:none; border-top:none; border-left:none; border-right:none; font-family:'Outfit',sans-serif; }
.ph-founder-toggle svg { width:11px; height:11px; stroke:var(--coral); fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; transition:transform 0.2s; }
.ph-founder-toggle.open svg { transform:rotate(180deg); }
.ph-founder-sig { margin-top:36px; padding-top:24px; border-top:1px solid var(--border); }
.ph-founder-sig-name { font-size:var(--fs-body); font-weight:400; color:var(--slate); margin-bottom:2px; }
.ph-founder-sig-title { font-size:var(--fs-meta); font-weight:300; color:var(--sage); }
@media(max-width:768px) { .ph-founder { min-height:auto; } .ph-founder-img { position:relative; width:100%; height:320px; object-position:center top; display:block; } .ph-founder-grad { background:linear-gradient(to bottom, rgba(245,240,234,0) 40%, rgba(245,240,234,1) 90%); } .ph-founder-content { padding:32px 20px 48px; max-width:100%; } }

/* aim mission vision &mdash; 3 cards */
.ph-amv { background:var(--slate); border-bottom:1px solid rgba(143,168,168,0.2); padding:64px 56px; }
.ph-amv-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.ph-amv-card { background:rgba(255,255,255,0.04); border:1px solid rgba(143,168,168,0.15); border-radius:4px; padding:32px 28px; }
.ph-amv-label { font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; margin-bottom:14px; }
.ph-amv-label.coral { color:var(--coral); }
.ph-amv-label.teal { color:var(--teal); }
.ph-amv-label.sage { color:var(--sage); }
.ph-amv-text { font-size:var(--fs-body); font-weight:200; color:var(--cream); line-height:1.75; }
@media(max-width:768px) { .ph-amv { padding:52px 20px; } .ph-amv-grid { grid-template-columns:1fr; gap:16px; } }

/* RE manifesto intro */
.ph-re-intro { padding:72px 56px 48px; max-width:760px; border-bottom:1px solid var(--border); background:var(--cream); }
.ph-re-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--coral); margin-bottom:20px; }
.ph-re-ey-line { width:24px; height:1px; background:var(--coral); flex-shrink:0; }
.ph-re-title { font-size:var(--fs-h1); font-weight:200; letter-spacing:-1px; color:var(--slate); line-height:1.15; margin-bottom:20px; }
.ph-re-sub { font-size:var(--fs-body); font-weight:300; color:var(--slate-l); line-height:1.85; }
@media(max-width:768px) { .ph-re-intro { padding:48px 20px 40px; } }

/* pillar strip */
.ph-pillars-wrap { background:var(--cream); border-bottom:1px solid var(--border); }
.ph-strip { position:sticky; top:var(--nav-h); z-index:50; display:flex; align-items:center; border-bottom:1px solid var(--border); background:rgba(245,240,234,0.97); backdrop-filter:blur(10px); overflow-x:auto; scrollbar-width:none; padding:0 44px; height:44px; gap:0; }
.ph-strip::-webkit-scrollbar { display:none; }
.ph-strip-item { font-size:var(--fs-micro); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:var(--sage); padding:0 20px; white-space:nowrap; border-right:1px solid var(--border); height:100%; display:flex; align-items:center; transition:color 0.15s; cursor:pointer; text-decoration:none; }
.ph-strip-item:first-child { padding-left:0; }
.ph-strip-item:last-child { border-right:none; }
.ph-strip-item.active { color:var(--coral); }
.ph-strip-item:hover { color:var(--slate); }
.ph-pillar { display:grid; grid-template-columns:1fr 1fr; border-bottom:1px solid var(--border); }
.ph-pillar:last-child { border-bottom:none; }
.ph-pillar-img { overflow:hidden; background:var(--cream-d); aspect-ratio:4/3; }
.ph-pillar-img img { width:100%; height:100%; object-fit:contain; display:block; transition:transform 0.6s; }
.ph-pillar:hover .ph-pillar-img img { transform:scale(1.03); }
.ph-pillar-content { padding:56px 52px; display:flex; flex-direction:column; justify-content:center; border-left:1px solid var(--border); background:var(--cream); }
.ph-pillar:nth-child(even) { direction:rtl; }
.ph-pillar:nth-child(even)>* { direction:ltr; }
.ph-pillar:nth-child(even) .ph-pillar-content { border-left:none; border-right:1px solid var(--border); background:var(--cream-d); }
.ph-pillar-num { font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--coral); margin-bottom:16px; display:flex; align-items:center; gap:10px; }
.ph-pillar-num::after { content:''; flex:1; height:1px; background:rgba(193,107,69,0.2); max-width:40px; }
.ph-pillar-title { font-size:var(--fs-h2); font-weight:200; letter-spacing:-0.5px; color:var(--slate); line-height:1.2; margin-bottom:20px; }
.ph-pillar-body { font-size:var(--fs-body); font-weight:300; color:var(--slate-l); line-height:1.85; max-width:380px; }
@media(max-width:768px) { .ph-strip { padding:0 20px; } .ph-pillar { grid-template-columns:1fr; direction:ltr; } .ph-pillar:nth-child(even) { direction:ltr; } .ph-pillar-img { aspect-ratio:16/9; } .ph-pillar-content { padding:32px 20px; border-left:none!important; border-right:none!important; border-top:1px solid var(--border); } }

/* what we believe */
.ph-beliefs { background:var(--cream-d); border-bottom:1px solid var(--border); }
.ph-beliefs-head { padding:64px 56px 0; margin-bottom:0; }
.ph-beliefs-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--teal); margin-bottom:16px; }
.ph-beliefs-ey-line { width:24px; height:1px; background:var(--teal); flex-shrink:0; }
.ph-beliefs-title { font-size:var(--fs-h1); font-weight:200; letter-spacing:-0.5px; color:var(--slate); line-height:1.2; margin-bottom:20px; }
.ph-beliefs-sub { font-size:var(--fs-body); font-weight:300; color:var(--slate-l); line-height:1.8; max-width:520px; margin-bottom:0; padding-bottom:40px; }
.ph-beliefs-grid { display:grid; grid-template-columns:repeat(5,1fr); border-top:1px solid var(--border); }
.ph-belief { padding:36px 28px 40px; border-right:1px solid var(--border); }
.ph-belief:last-child { border-right:none; }
.ph-belief-num { font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:var(--teal); margin-bottom:16px; display:block; }
.ph-belief-title { font-size:var(--fs-body); font-weight:300; color:var(--slate); line-height:1.35; margin-bottom:12px; }
.ph-belief-body { font-size:var(--fs-sm); font-weight:300; color:var(--slate-l); line-height:1.7; }
@media(max-width:900px) { .ph-beliefs-grid { grid-template-columns:repeat(2,1fr); } .ph-belief:nth-child(2n) { border-right:none; } .ph-beliefs-head { padding:44px 20px 0; } }
@media(max-width:600px) { .ph-beliefs-grid { grid-template-columns:1fr; } .ph-belief { border-right:none; border-bottom:1px solid var(--border); padding:28px 20px; } .ph-belief:last-child { border-bottom:none; } }

/* collab &mdash; teal bg, content left, image right */
.ph-collab { background:var(--teal); border-bottom:1px solid rgba(255,255,255,0.12); }
.ph-collab-inner { display:grid; grid-template-columns:1fr 1fr; min-height:480px; }
.ph-collab-inner > div:first-child { padding:72px 56px; display:flex; flex-direction:column; justify-content:center; border-right:1px solid rgba(255,255,255,0.12); }
.ph-collab-right-img { overflow:hidden; background:rgba(255,255,255,0.06); }
.ph-collab-right-img img { width:100%; height:100%; object-fit:contain; display:block; }
.ph-collab-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:rgba(245,240,234,0.65); margin-bottom:20px; }
.ph-collab-ey-line { width:24px; height:1px; background:rgba(245,240,234,0.4); flex-shrink:0; }
.ph-collab-title { font-size:var(--fs-h1); font-weight:200; letter-spacing:-1px; color:white; line-height:1.15; margin-bottom:20px; }
.ph-collab-em { color:rgba(245,240,234,0.75); font-style:normal; }
.ph-collab-body { font-size:var(--fs-body); font-weight:300; color:rgba(245,240,234,0.8); line-height:1.8; margin-bottom:28px; max-width:400px; }
.ph-collab-who-lbl { font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:rgba(245,240,234,0.5); margin-bottom:12px; margin-top:28px; }
.ph-collab-pills { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:32px; }
.ph-collab-pill { font-size:var(--fs-meta); font-weight:300; color:rgba(245,240,234,0.8); border:1px solid rgba(245,240,234,0.25); padding:5px 14px; border-radius:20px; }
.ph-collab-btn { display:inline-flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; background:rgba(255,255,255,0.15); color:white; border:1px solid rgba(255,255,255,0.3); padding:14px 28px; border-radius:3px; cursor:pointer; font-family:'Outfit',sans-serif; text-decoration:none; transition:background 0.15s; }
.ph-collab-btn:hover { background:rgba(255,255,255,0.22); }
.ph-collab-btn svg { width:12px; height:12px; stroke:white; fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
.ph-collab-right { display:flex; flex-direction:column; gap:16px; }
.ph-collab-right .ph-collab-tag { padding:20px 24px; border:1px solid rgba(245,240,234,0.15); border-radius:4px; background:rgba(255,255,255,0.06); }
.ph-collab-right .ph-collab-tag-title { font-size:var(--fs-sm); font-weight:300; color:white; margin-bottom:4px; }
.ph-collab-right .ph-collab-tag-desc { font-size:var(--fs-meta); font-weight:300; color:rgba(245,240,234,0.65); line-height:1.5; }
@media(max-width:768px) { .ph-collab { padding:52px 20px; } .ph-collab-inner { grid-template-columns:1fr; gap:36px; } }


.crumb{position:sticky;top:var(--nav-h);z-index:100;background:rgba(245,240,234,0.97);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px;padding:0 44px;height:44px;font-size:var(--fs-lbl);font-weight:300;letter-spacing:1.8px;text-transform:uppercase;color:var(--slate-l);}
.crumb a{color:var(--slate-l);cursor:pointer;}
.crumb a:hover{color:var(--slate);}
.crumb .cur{color:var(--coral);}
.crumb .sep{opacity:0.5;}
.sec-hdr{padding:44px 44px 8px;}
.sec-ey{display:flex;align-items:center;gap:10px;font-size:var(--fs-lbl);font-weight:300;letter-spacing:2.5px;text-transform:uppercase;color:var(--coral);margin-bottom:12px;}
.sec-ey-line{width:24px;height:1px;background:var(--coral);flex-shrink:0;}
.sec-title{font-size:var(--fs-h1);font-weight:200;letter-spacing:-0.8px;color:var(--slate);margin-bottom:6px;}
.sec-sub{font-size:var(--fs-sm);font-weight:300;color:var(--slate-l);max-width:560px;line-height:1.7;}
/* PRODUCT PAGE */
.pd{display:grid;grid-template-columns:1.15fr 1fr;border-bottom:1px solid var(--border);}
.pd-media{border-right:1px solid var(--border);padding:44px;}
.gallery{display:flex;gap:14px;}
.thumbs{display:flex;flex-direction:column;gap:10px;width:74px;flex-shrink:0;}
.thumb{width:74px;height:74px;border:1px solid var(--border);overflow:hidden;cursor:pointer;background:var(--cream-d);transition:border-color 0.15s;padding:0;}
.thumb img{width:100%;height:100%;object-fit:contain;display:block;transition:opacity 0.15s;}
.thumb:hover img{opacity:0.85;}
