<!-- ============================================================
     TAG FILTERING (instant, no page reload)
     Clicking a tab in the filter strip shows only the "From the
     Loop" cards whose data-tag matches. This filters the cards
     already on the page. Category tags come from each article's
     first Shopify tag — tag every article in the admin so it
     shows up under the right heading (e.g. tag it "Declutter &
     Organise" so it appears under that tab). Untagged articles
     default to "Intentional Living".
     ============================================================ -->
<script>
  (function () {
    function initLoopFilter() {
      var strip = document.getElementById('lp-filter-strip');
      var grid = document.getElementById('lp-article-grid');
      var countEl = document.getElementById('lp-count');
      if (!strip || !grid) return;

      var tabs = strip.querySelectorAll('.lp-tab');
      var cards = grid.querySelectorAll('.lp-m-card');
      var totalLabel = countEl ? countEl.textContent : '';

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var tag = tab.getAttribute('data-tag');

          tabs.forEach(function (t) { t.classList.remove('active'); });
          tab.classList.add('active');

          var visibleCount = 0;
          cards.forEach(function (card) {
            var match = tag === 'all' || card.getAttribute('data-tag') === tag;
            card.style.display = match ? '' : 'none';
            if (match) visibleCount++;
          });

          if (countEl) {
            countEl.textContent = tag === 'all'
              ? totalLabel
              : visibleCount + (visibleCount === 1 ? ' article' : ' articles');
          }
        });
      });
    }

    initLoopFilter();
    document.addEventListener('shopify:section:load', initLoopFilter);
  })();
</script>

