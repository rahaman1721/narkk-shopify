<style>
.sp-pipeline { background:#EDE7DE; border-top:1px solid rgba(143,168,168,0.22); border-bottom:1px solid rgba(143,168,168,0.22); }
.sp-pipeline-head { padding:52px 44px 36px; border-bottom:1px solid rgba(143,168,168,0.22); }
.sp-pipeline-ey { display:flex; align-items:center; gap:10px; font-size:10px; font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:#C16B45; margin-bottom:10px; }
.sp-pipeline-ey-line { width:24px; height:1px; background:#C16B45; flex-shrink:0; }
.sp-pipeline-title { font-size:44px; font-weight:200; letter-spacing:-0.5px; color:#334155; margin-bottom:6px; }
.sp-pipeline-sub { font-size:14px; font-weight:300; color:#64748B; }
.sp-pipeline-grid { display:grid; grid-template-columns:repeat(3,1fr); border-bottom:1px solid rgba(143,168,168,0.22); }
.sp-pipe-tile { padding:44px 36px 48px; border-right:1px solid rgba(143,168,168,0.22); border-bottom:1px solid rgba(143,168,168,0.22); display:flex; flex-direction:column; }
.sp-pipe-tile:nth-child(3n) { border-right:none; }
.sp-pipe-tile:nth-child(n+4) { border-bottom:none; }
.sp-pipe-icon { width:44px; height:44px; margin-bottom:28px; }
.sp-pipe-icon svg { width:100%; height:100%; stroke:#C16B45; fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
.sp-pipe-name { font-size:22px; font-weight:200; letter-spacing:-0.3px; color:#334155; margin-bottom:12px; }
.sp-pipe-desc { font-size:14px; font-weight:300; color:#64748B; line-height:1.75; margin-bottom:24px; flex:1; }
.sp-pipe-status { font-size:10px; font-weight:300; letter-spacing:1.8px; text-transform:uppercase; color:#C16B45; border:1px solid rgba(193,107,69,0.4); padding:4px 12px; border-radius:20px; width:fit-content; }
@media(max-width:900px) { .sp-pipeline-grid { grid-template-columns:repeat(2,1fr); } .sp-pipe-tile:nth-child(3n) { border-right:1px solid rgba(143,168,168,0.22); } .sp-pipe-tile:nth-child(2n) { border-right:none; } .sp-pipe-tile:nth-child(n+4) { border-bottom:1px solid rgba(143,168,168,0.22); } .sp-pipe-tile:last-child { border-bottom:none; } .sp-pipe-tile { padding:32px 24px; } .sp-pipeline-head { padding:40px 20px 28px; } }
@media(max-width:500px) { .sp-pipeline-grid { grid-template-columns:1fr; } .sp-pipe-tile { border-right:none !important; border-bottom:1px solid rgba(143,168,168,0.22) !important; } .sp-pipe-tile:last-child { border-bottom:none !important; } }
</style>

  <div class="sp-pipeline">
    <div class="sp-pipeline-head">
      <div class="sp-pipeline-ey"><span class="sp-pipeline-ey-line"></span>{{ section.settings.eyebrow | default: 'Our Pipeline' }}</div>
      <div class="sp-pipeline-title">{{ section.settings.title | default: 'Products we are building.' }}</div>
      <div class="sp-pipeline-sub">{{ section.settings.subtitle | default: 'We want to create products with intention &mdash; so we are categorising them by the way people live.' }}</div>
    </div>
    <div class="sp-pipeline-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <div class="sp-pipe-tile" {{ block.shopify_attributes }}>
            <div class="sp-pipe-icon">
              {% if block.settings.svg_icon != blank %}
                {{ block.settings.svg_icon }}
              {% else %}
                <!-- Fallback icon -->
                <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="10" stroke="#C16B45" stroke-width="1.5" fill="none"/></svg>
              {% endif %}
            </div>
            <div class="sp-pipe-name">{{ block.settings.title }}</div>
            <div class="sp-pipe-desc">{{ block.settings.description }}</div>
            <span class="sp-pipe-status">{{ block.settings.status }}</span>
          </div>
        {% endfor %}
      {% else %}
        <!-- Nourish -->
        <div class="sp-pipe-tile">
          <div class="sp-pipe-icon"><svg viewBox="0 0 40 40" fill="none" stroke="#C16B45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Bowl with Steam -->
            <path d="M8 20 Q8 30 20 30 Q32 30 32 20" stroke-linecap="round"></path>
            <line x1="6" y1="20" x2="34" y2="20"></line>
            <line x1="18" y1="10" x2="18" y2="16"></line>
            <line x1="22" y1="8" x2="22" y2="16"></line>
          </svg></div>
          <div class="sp-pipe-name">Nourish</div>
          <div class="sp-pipe-desc">A concept library &mdash; starting with a kids' lunch series, mindful eating built into daily habit.</div>
          <span class="sp-pipe-status">Concept stage</span>
        </div>

        <!-- Thogai -->
        <div class="sp-pipe-tile">
          <div class="sp-pipe-icon"><svg viewBox="0 0 40 40" fill="none" stroke="#C16B45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Modular Sofa -->
            <rect x="11" y="11" width="8" height="13" rx="1.5" />
            <rect x="21" y="15" width="8" height="9" rx="1.5" />
            <rect x="9" y="24" width="22" height="7" rx="1.5" />
          </svg></div>
          <div class="sp-pipe-name">Thogai</div>
          <div class="sp-pipe-desc">Modular seating &mdash; backrest, support, and cover, each one separate and replaceable. Prototype is built, we're refining it before it scales.</div>
          <span class="sp-pipe-status">Prototype built</span>
        </div>

        <!-- Thunn -->
        <div class="sp-pipe-tile">
          <div class="sp-pipe-icon"><svg viewBox="0 0 40 40" fill="none" stroke="#C16B45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Cabinet -->
            <rect x="10" y="8" width="20" height="24" rx="1"></rect>
            <line x1="10" y1="18" x2="30" y2="18"></line>
            <line x1="10" y1="26" x2="30" y2="26"></line>
            <line x1="14" y1="32" x2="14" y2="36"></line>
            <line x1="26" y1="32" x2="26" y2="36"></line>
          </svg></div>
          <div class="sp-pipe-name">Thunn</div>
          <div class="sp-pipe-desc">Already manufactured and sold to retail &mdash; now getting new accessories and a full rework for the home wall.</div>
          <span class="sp-pipe-status">Reimagining</span>
        </div>

        <!-- Play -->
        <div class="sp-pipe-tile">
          <div class="sp-pipe-icon"><svg viewBox="0 0 40 40" fill="none" stroke="#C16B45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Head -->
            <circle cx="20" cy="16" r="9"></circle>
            <path d="M14 34 C14 28 26 28 26 34" stroke-linecap="round"></path>
            <circle cx="20" cy="16" r="3"></circle>
          </svg></div>
          <div class="sp-pipe-name">Play</div>
          <div class="sp-pipe-desc">From the forgotten toys of the past to carefully curated play items for kids and adults. Anything that takes your mind off and puts you in a flow state.</div>
          <span class="sp-pipe-status">Concept stage</span>
        </div>

        <!-- Coexist -->
        <div class="sp-pipe-tile">
          <div class="sp-pipe-icon"><svg viewBox="0 0 40 40" fill="none" stroke="#C16B45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Pet Bowl/Collar -->
            <ellipse cx="20" cy="24" rx="10" ry="6"></ellipse>
            <path d="M12 22 Q10 14 16 12" stroke-linecap="round"></path>
            <circle cx="16" cy="11" r="2"></circle>
            <path d="M28 22 Q30 14 24 12" stroke-linecap="round"></path>
          </svg></div>
          <div class="sp-pipe-name">Coexist</div>
          <div class="sp-pipe-desc">We don't just design products for humans. From a small dog stepper to a bird house &mdash; this is a place for your pets and your egalitarian mindset.</div>
          <span class="sp-pipe-status">Concept stage</span>
        </div>

        <!-- Nourish -->
        <div class="sp-pipe-tile">
          <div class="sp-pipe-icon"><svg viewBox="0 0 40 40" fill="none" stroke="#C16B45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <!-- Bowl with 2 steam lines -->
            <line x1="17" y1="8" x2="17" y2="14"/>
            <line x1="23" y1="8" x2="23" y2="14"/>
            <line x1="9" y1="18" x2="31" y2="18"/>
            <path d="M9 18 C9 28 31 28 31 18"/>
          </svg></div>
          <div class="sp-pipe-name">Nourish</div>
          <div class="sp-pipe-desc">A concept library &mdash; starting with a kids' lunch series, mindful eating built into daily habit.</div>
          <span class="sp-pipe-status">Concept stage</span>
        </div>
      {% endif %}
    </div>
  </div>

{% schema %}
