<script>
document.addEventListener('DOMContentLoaded', () => {
  const links = document.querySelectorAll('.lg-sidebar-link');
  const sections = document.querySelectorAll('.lg-sec');
  const isMobile = () => window.innerWidth <= 900;
  const mainContainer = document.querySelector('.lg-main');

  function showSection(targetId) {
    sections.forEach(sec => sec.classList.remove('mob-active'));
    const target = document.getElementById(targetId);
    if (target) target.classList.add('mob-active');
  }

  function setActiveLink(targetHref) {
    links.forEach(link => {
      if (link.getAttribute('href') === targetHref) {
        link.classList.add('active');
        link.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        link.classList.remove('active');
      }
    });
  }

  function handleHash() {
    let hash = window.location.hash;
    if (!hash && sections.length > 0) {
      hash = '#' + sections[0].id;
    }
    
    if (hash) {
      const targetId = hash.replace('#', '');
      
      if (isMobile()) {
        showSection(targetId);
        setActiveLink(hash);
        if (mainContainer) mainContainer.scrollTop = 0;
        const sidebar = document.querySelector('.lg-sidebar');
        if (sidebar) {
          window.scrollTo({ top: sidebar.getBoundingClientRect().top + window.scrollY - 65, behavior: 'smooth' });
        }
      } else {
        setActiveLink(hash);
        const targetElement = document.getElementById(targetId);
        if (targetElement && mainContainer) {
          setTimeout(() => {
            mainContainer.scrollTo({
              top: targetElement.offsetTop - 40,
              behavior: 'smooth'
            });
          }, 100);
        }
      }
    }
  }

  links.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href').replace('#', '');
      window.history.pushState(null, null, '#' + targetId);
      handleHash();
    });
  });

  handleHash();
  window.addEventListener('hashchange', handleHash);

  if (!isMobile()) {
    const observerOptions = {
      root: document.querySelector('.lg-main'),
      rootMargin: '-20% 0px -60% 0px',
      threshold: 0
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          setActiveLink('#' + id);
        }
      });
    }, observerOptions);

    sections.forEach(sec => observer.observe(sec));
  }
});
</script>

