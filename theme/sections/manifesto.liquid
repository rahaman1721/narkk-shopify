<style>
/* RE-MANIFESTO */
.hp-mani { background:var(--slate); border-bottom:1px solid var(--border); }
/* fallback ratio; header.liquid's script overrides this inline with the exact
   measured "LOOP" boundary so the divide matches the hero, split and starter.
   gap:0 is intentional — spacing now comes from padding on each side so the
   visible border-left on .hp-mani-rotator sits exactly on the spine instead
   of being pushed off by half a grid gap. */
/* Full-bleed breakout — see hero-split.liquid for why. */
.hp-mani-inner { width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw); box-sizing:border-box; padding:80px 0 88px; display:grid; grid-template-columns:var(--col-split); gap:0; align-items:center; }
.hp-mani-left { padding-left:56px; padding-right:56px; }
.hp-mani-ey { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--coral); margin-bottom:0; }
.hp-mani-ey-line { width:24px; height:1px; background:var(--coral); flex-shrink:0; }
.hp-mani-title { font-size:var(--fs-h1); font-weight:200; letter-spacing:-1px; color:var(--cream); line-height:1.1; margin-top:24px; margin-bottom:28px; }
.hp-mani-body { font-size:var(--fs-body); font-weight:300; color:rgba(237,231,222,0.8); line-height:1.85; max-width:520px; margin-bottom:0; }
/* five words rotator */
.hp-mani-rotator { position:relative; height:220px; display:flex; align-items:center; justify-content:center; padding-left:56px; padding-right:56px; border-left:1px solid rgba(143,168,168,0.25); }
.hp-mani-rot-item { position:absolute; display:flex; flex-direction:column; align-items:center; gap:20px; opacity:0; transform:translateY(10px); transition:opacity 0.5s ease, transform 0.5s ease; }
.hp-mani-rot-item.active { opacity:1; transform:translateY(0); }
.hp-mani-word-icon { width:72px; height:72px; display:flex; align-items:center; justify-content:center; }
.hp-mani-word-icon svg { width:60px; height:60px; stroke:var(--coral); fill:none; stroke-width:1.2; stroke-linecap:round; stroke-linejoin:round; }
.hp-mani-word-label { font-size:var(--fs-disp); font-weight:200; color:var(--cream); letter-spacing:-1.5px; text-align:center; }
.hp-mani-footer { margin-top:32px; text-align:left; display:flex; justify-content:flex-start; }
.hp-mani-cta { display:inline-flex; align-items:center; gap:8px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:1.8px; text-transform:uppercase; color:var(--coral); text-decoration:none; border-bottom:1px solid rgba(193,107,69,0.4); padding-bottom:2px; transition:opacity 0.15s; }
.hp-mani-cta:hover { opacity:0.65; }
.hp-mani-cta svg { width:11px; height:11px; stroke:var(--coral); fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
@media(max-width:768px) {
  .hp-mani-inner { grid-template-columns:1fr; padding:56px 20px 64px; gap:40px; }
  .hp-mani-left { padding-left:0; padding-right:0; }
  .hp-mani-rotator { border-left:none; border-top:1px solid rgba(143,168,168,0.25); padding-top:40px; padding-left:0; padding-right:0; height:200px; }
  /* Shrink the rotating large word so it doesn't overflow narrow phones */
  .hp-mani-word-label { font-size:clamp(32px,10vw,56px); }
}
</style>

<!-- RE-MANIFESTO -->
<section class="hp-mani">
  <div class="hp-mani-inner">
    <div class="hp-mani-left">
      <div class="hp-mani-ey"><span class="hp-mani-ey-line"></span>The RE-Manifesto</div>
      <div class="hp-mani-title">Built for life, not the landfill.</div>
      <div class="hp-mani-body">We stand as a direct counter-narrative to &ldquo;fast furniture&rdquo; and planned obsolescence. Our aim is not to mass produce to fill the landfill and greenwash our intentions. We produce limited, essential products with an ultimate goal where no piece of narkk ever enters a landfill.</div>
      <div class="hp-mani-footer">
        <a href="/pages/philosophy" class="hp-mani-cta">Know more <svg viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></a>
      </div>
    </div>
    <div class="hp-mani-rotator" id="mani-rotator">
      <div class="hp-mani-rot-item active">
        <div class="hp-mani-word-icon"><svg viewBox="0 0 24 24"><path d="M9 14l-4-4 4-4"></path><path d="M5 10h11a4 4 0 0 1 0 8h-1"></path></svg></div>
        <div class="hp-mani-word-label">Return</div>
      </div>
      <div class="hp-mani-rot-item">
        <div class="hp-mani-word-icon"><svg viewBox="0 0 24 24"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg></div>
        <div class="hp-mani-word-label">Restore</div>
      </div>
      <div class="hp-mani-rot-item">
        <div class="hp-mani-word-icon"><svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg></div>
        <div class="hp-mani-word-label">Resale</div>
      </div>
      <div class="hp-mani-rot-item">
        <div class="hp-mani-word-icon"><svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg></div>
        <div class="hp-mani-word-label">Reimagine</div>
      </div>
      <div class="hp-mani-rot-item">
        <div class="hp-mani-word-icon"><svg viewBox="0 0 24 24"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg></div>
        <div class="hp-mani-word-label">Recycle</div>
      </div>
    </div>
  </div>
</section>

<script>
// ── RE-MANIFESTO WORD ROTATOR
(function() {
  var rotator = document.getElementById('mani-rotator');
  if (!rotator) return;
  var items = rotator.querySelectorAll('.hp-mani-rot-item');
  var i = 0;
  setInterval(function() {
    items[i].classList.remove('active');
    i = (i + 1) % items.length;
    items[i].classList.add('active');
  }, 2200);
})();
</script>

{% schema %}
{
  "name": "Homepage Manifesto",
  "presets": [{ "name": "Homepage Manifesto" }]
}
{% endschema %}