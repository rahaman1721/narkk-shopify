<script>
(function(){
'use strict';

// ── Beliefs in-view animation
if ('IntersectionObserver' in window) {
  var bio = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { e.target.classList.add('in-view'); bio.unobserve(e.target); }
    });
  }, { rootMargin: '-80px 0px', threshold: 0 });
  document.querySelectorAll('.ph-bitem').forEach(function(el) { bio.observe(el); });
}

// ── Pillar slider (scroll-snap based)
var stage  = document.getElementById('ph-pillar-stage');
var btnPrev = document.getElementById('ph-prev');
var btnNext = document.getElementById('ph-next');
var tabs   = document.querySelectorAll('#ph-strip .ph-strip-item');
var total  = tabs.length;
var cur    = 0;

// Guard: if the slider markup isn't present (e.g. section HTML gets edited later),
// skip wiring up the slider instead of throwing on null.addEventListener.
if (stage && btnPrev && btnNext && total) {

  function goTo(idx) {
    cur = Math.max(0, Math.min(total - 1, idx));
    stage.scrollTo({ left: stage.clientWidth * cur, behavior: 'smooth' });
    syncUI();
  }

  var strip = document.getElementById('ph-strip');

  function syncUI() {
    btnPrev.disabled = cur === 0;
    btnNext.disabled = cur === total - 1;
    tabs.forEach(function(t, i) { t.classList.toggle('active', i === cur); });
    scrollStripToActive();
  }

  // Keeps the active tab (and the next one or two) visible in the tab row,
  // so people don't have to manually swipe the strip to find the next tab.
  function scrollStripToActive() {
    if (!strip) return;
    var activeTab = tabs[cur];
    if (!activeTab) return;
    // Position the active tab a little in from the left edge, so the next
    // tab(s) are already peeking into view on the right.
    var leadIn = 24;
    var target = activeTab.offsetLeft - leadIn;
    target = Math.max(0, Math.min(target, strip.scrollWidth - strip.clientWidth));
    strip.scrollTo({ left: target, behavior: 'smooth' });
  }

  btnPrev.addEventListener('click', function() { goTo(cur - 1); });
  btnNext.addEventListener('click', function() { goTo(cur + 1); });

  tabs.forEach(function(tab, i) {
    tab.addEventListener('click', function(e) { e.preventDefault(); goTo(i); });
  });

  // Sync tab on manual scroll
  var scrollTimer;
  stage.addEventListener('scroll', function() {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(function() {
      var idx = Math.round(stage.scrollLeft / Math.max(stage.clientWidth, 1));
      if (idx !== cur) { cur = idx; syncUI(); }
    }, 80);
  }, { passive: true });
}

})();
</script>

