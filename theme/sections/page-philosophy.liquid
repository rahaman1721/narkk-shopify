<style>
/* ================================================================
   PHILOSOPHY PAGE &mdash; FULL REBUILD
   Variables
================================================================ */
:root {
  --cream:#F5F0EA; --cream-d:#EDE7DE; --slate:#334155; --slate-l:#64748B;
  --sage:#8FA8A8; --teal:#4A9B8E; --coral:#C16B45;
  --border:rgba(143,168,168,0.22); --border-m:rgba(143,168,168,0.38);
  --fs-disp:64px; --fs-h1:34px; --fs-h2:24px; --fs-h3:19px;
  --fs-body:16px; --fs-sm:14px; --fs-lbl:11px; --fs-meta:12px; --fs-micro:10px;
}

/* ---- PG HERO ---------------------------------------------------------------------------------------------- */
.pg-hero { background:var(--cream); border-bottom:1px solid var(--border); }
.pg-hero-top {
  padding: 72px 56px 64px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto 1fr;
  min-height: 340px;
  align-items: start;
}
.pg-hero-left { grid-column:1; grid-row:1/3; display:flex; flex-direction:column; justify-content:space-between; padding:0; padding-right:40px; border-right:none; }
.pg-hero-right { grid-column:2; grid-row:2; align-self:end; padding:0; }
.pg-eyebrow { display:flex; align-items:center; gap:10px; font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; }
.pg-eyebrow-line { width:24px; height:1px; flex-shrink:0; }
.pg-eyebrow.coral { color:var(--coral); } .pg-eyebrow.coral .pg-eyebrow-line { background:var(--coral); }
.pg-hero-title { font-family:'Outfit',sans-serif; font-size:clamp(44px,14vw,64px); font-weight:200; letter-spacing:-2px; line-height:1; color:var(--slate); margin-top:24px; }
.pg-hero-desc { font-family:'Outfit',sans-serif; font-size:clamp(15px,1.4vw,18px); font-weight:300; color:var(--slate-l); line-height:1.85; max-width:420px; }
.pg-hero-img { width:100%; aspect-ratio:4/1; overflow:hidden; background:var(--cream-d); }
.pg-hero-img img { width:100%; height:100%; object-fit:cover; display:block; }
@media(max-width:768px) {
  .pg-hero-top { grid-template-columns:1fr; padding:48px 20px 44px; min-height:unset; }
  .pg-hero-left { padding-right:0; grid-row:auto; }
  .pg-hero-right { grid-column:1; grid-row:auto; margin-top:24px; }
  .pg-hero-title { font-size:clamp(44px,14vw,64px); }
  .pg-hero-desc { font-size:var(--fs-body); }
  .pg-hero-img { aspect-ratio:2/1; }
}

/* ---- PH FOUNDER -------------------------------------------------------------------------------------- */
.ph-founder { position:relative; width:100%; min-height:90vh; border-bottom:1px solid var(--border); background:var(--cream); overflow:hidden; }
.ph-founder-img { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; object-position:right center; display:block; }
/* Stronger gradient — fully opaque through the text column, fades after 52% */
.ph-founder-grad { position:absolute; top:0; left:0; width:100%; height:100%; background:linear-gradient(to right,rgba(245,240,234,1) 0%,rgba(245,240,234,1) 35%,rgba(245,240,234,0.88) 48%,rgba(245,240,234,0.3) 58%,rgba(245,240,234,0) 68%); pointer-events:none; }
/* Both content + expand share the same column — 56px left, capped at 496px total */
.ph-founder-content { position:relative; z-index:2; width:100%; max-width:496px; padding:72px 0 0 56px; }
.ph-founder-ey { display:flex; align-items:center; gap:10px; font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--coral); margin-bottom:28px; }
.ph-founder-ey-line { width:24px; height:1px; background:var(--coral); flex-shrink:0; }
.ph-founder-sal { font-family:'Outfit',sans-serif; font-size:var(--fs-sm); font-weight:300; color:var(--coral); letter-spacing:0.5px; margin-bottom:20px; }
.ph-founder-body { font-family:'Outfit',sans-serif; font-size:14px; font-weight:300; color:#334155; line-height:1.9; margin-bottom:16px; max-width:440px; }
.ph-founder-toggle { display:inline-flex; align-items:center; gap:8px; font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; color:var(--coral); cursor:pointer; border-bottom:1px solid rgba(193,107,69,0.3); padding-bottom:2px; margin-top:8px; background:none; border-top:none; border-left:none; border-right:none; }
.ph-founder-toggle svg { width:11px; height:11px; stroke:var(--coral); fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; transition:transform 0.2s; }
.ph-founder-toggle.open svg { transform:rotate(180deg); }
/* Mobile-only eyebrow shown above the image */
.ph-founder-ey-mobile { display:none; }
/* Expanded content — same column, seamless continuation */
.ph-founder-expand {
  position:relative; z-index:2;
  width:100%; max-width:496px;
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  transition: max-height 0.7s cubic-bezier(0.4,0,0.2,1), opacity 0.4s ease;
}
.ph-founder-expand.open {
  max-height: 2400px;
  opacity: 1;
}
.ph-founder-expand-inner {
  padding: 0 0 72px 56px;
}
/* Exact same style as .ph-founder-body */
.ph-founder-expand-inner p { font-family:'Outfit',sans-serif; font-size:14px; font-weight:300; color:#334155; line-height:1.9; margin-bottom:16px; max-width:440px; }
.ph-founder-sig { margin-top:28px; padding-top:28px; border-top:1px solid rgba(143,168,168,0.22); max-width:440px; }
.ph-founder-sig-name { font-family:'Outfit',sans-serif; font-size:14px; font-weight:400; color:#334155; margin-bottom:4px; }
.ph-founder-sig-title { font-family:'Outfit',sans-serif; font-size:11px; font-weight:300; color:var(--sage); }
@media(max-width:768px) {
  .ph-founder { min-height:auto; }
  .ph-founder-ey-mobile { display:flex; align-items:center; gap:10px; font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--coral); padding:24px 20px 16px; background:var(--cream); }
  .ph-founder-img { position:relative; width:100%; height:320px; object-fit:cover; object-position:center top; display:block; }
  .ph-founder-grad { background:linear-gradient(to bottom,rgba(245,240,234,0) 40%,rgba(245,240,234,1) 90%); }
  .ph-founder-content { position:relative; padding:32px 20px 0; max-width:100%; width:100%; }
  .ph-founder-content .ph-founder-ey { display:none; }
  .ph-founder-expand { max-width:100%; width:100%; }
  .ph-founder-expand-inner { padding:0 20px 32px; }
  .ph-founder-expand-inner p { max-width:100%; }
  .ph-founder-sig { max-width:100%; }
}

/* ---- RE-MANIFESTO INTRO ---- */
.ph-re-intro { padding:40px 56px 24px; max-width:820px; border-bottom:1px solid var(--border); background:var(--cream); flex:0 0 auto; }
.ph-re-ey { display:flex; align-items:center; gap:10px; font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--coral); margin-bottom:14px; }
.ph-re-ey-line { width:24px; height:1px; background:var(--coral); flex-shrink:0; }
.ph-re-title { font-family:'Outfit',sans-serif; font-size:var(--fs-h2); font-weight:200; letter-spacing:-1px; color:var(--slate); line-height:1.15; margin-bottom:12px; }
.ph-re-sub { font-family:'Outfit',sans-serif; font-size:var(--fs-sm); font-weight:300; color:var(--slate-l); line-height:1.7; max-width:680px; }
@media(max-width:768px) { .ph-re-intro { padding:48px 20px 40px; } }

/* ---- Wraps intro + strip + slider so together they fill exactly one screen (desktop only — mobile scrolls naturally) ---- */
@media(min-width:769px) {
  .ph-manifesto-screen { display:flex; flex-direction:column; height:calc(100vh - var(--nav-h) - var(--ann-h)); min-height:680px; }
  .ph-manifesto-screen .ph-re-intro { border-bottom:none; }
  .ph-manifesto-screen .ph-pillars-wrap { flex:1 1 auto; min-height:0; display:flex; flex-direction:column; }
  .ph-manifesto-screen .ph-strip { position:static; flex:0 0 auto; }
  .ph-manifesto-screen .ph-stage-frame { flex:1 1 auto; min-height:0; }
  .ph-manifesto-screen .ph-pillar-stage { height:100%; }
  .ph-manifesto-screen .ph-pillar { height:100%; grid-template-rows:1fr; }
  .ph-manifesto-screen .ph-pillar-img { aspect-ratio:auto; height:100%; align-self:stretch; }
  .ph-manifesto-screen .ph-pillar-content { padding:32px 56px; }
}

/* ---- PILLAR STRIP & SLIDER (matches reference exactly) ---- */
.ph-pillars-wrap { background:var(--cream); border-bottom:1px solid var(--border); }
.ph-strip {
  position:sticky; top:64px; z-index:50;
  display:flex; align-items:center;
  border-bottom:1px solid var(--border);
  background:rgba(245,240,234,0.97); backdrop-filter:blur(10px);
  overflow-x:auto; scrollbar-width:none;
  padding:0 44px; height:52px; gap:0;
}
.ph-strip::-webkit-scrollbar { display:none; }
.ph-strip-item {
  font-family:'Outfit',sans-serif;
  font-size:14px; font-weight:400; letter-spacing:2px; text-transform:uppercase;
  color:var(--sage);
  padding:0 26px; white-space:nowrap;
  border-right:1px solid var(--border);
  height:100%; display:flex; align-items:center;
  transition:color 0.15s; cursor:pointer; text-decoration:none;
}
.ph-strip-item:first-child { padding-left:0; }
.ph-strip-item:last-child { border-right:none; }
.ph-strip-item.active { color:var(--coral); }
.ph-strip-item:hover { color:var(--slate); }
.ph-strip-item.active:hover { color:var(--coral); }

/* Stage & nav buttons */
.ph-stage-frame { position:relative; }
.ph-nav-btn {
  position:absolute; top:50%; transform:translateY(-50%); z-index:20;
  width:46px; height:46px; border-radius:50%;
  border:1px solid var(--border);
  background:rgba(245,240,234,0.92); backdrop-filter:blur(8px);
  display:flex; align-items:center; justify-content:center;
  cursor:pointer; padding:0;
  transition:opacity 0.2s, background 0.2s, border-color 0.2s;
}
.ph-nav-btn svg { width:18px; height:18px; stroke:var(--coral); fill:none; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; }
.ph-nav-btn:hover { background:var(--cream-d); border-color:var(--sage); }
.ph-nav-btn[disabled] { opacity:0.25; cursor:default; }
.ph-nav-btn.prev { left:20px; }
.ph-nav-btn.next { right:20px; }

/* Scroll-snap stage */
.ph-pillar-stage {
  position:relative; display:flex;
  overflow-x:auto; overflow-y:hidden;
  scroll-snap-type:x mandatory;
  scrollbar-width:none; -webkit-overflow-scrolling:touch;
  overscroll-behavior-x:contain;
}
.ph-pillar-stage::-webkit-scrollbar { display:none; }
.ph-pillar-track { display:contents; }
.ph-pillar-track .ph-pillar { flex:0 0 100%; width:100%; min-width:100%; scroll-snap-align:start; }

/* Each pillar slide */
.ph-pillar { display:grid; grid-template-columns:0.8fr 1.2fr; border-bottom:1px solid var(--border); }
.ph-pillar:last-child { border-bottom:none; }
.ph-pillar-img { overflow:hidden; background:var(--cream-d); aspect-ratio:4/3; align-self:center; }
/* Change #8 (Xiamen updation): source photos have very different native aspect ratios
   (some tall portraits, some landscapes). object-fit:cover — not contain — is required
   so every slide fills its box identically instead of showing different amounts of
   letterbox padding depending on the source image's own shape. */
.ph-pillar-img img { width:100%; height:100%; object-fit:cover; object-position:center; display:block; transition:transform 0.6s; }
.ph-pillar:hover .ph-pillar-img img { transform:scale(1.03); }
.ph-pillar-content {
  padding:56px 64px; display:flex; flex-direction:column; justify-content:center;
  border-left:1px solid var(--border); background:var(--cream);
}
/* Alternate — even slides: content LEFT, image RIGHT */
.ph-pillar:nth-child(even) { grid-template-columns:1.2fr 0.8fr; }
.ph-pillar:nth-child(even) .ph-pillar-img { order: 2; }
.ph-pillar:nth-child(even) .ph-pillar-content { order: 1; border-left:none; border-right:1px solid var(--border); background:var(--cream-d); }

/* Pillar typography */
.ph-pillar-num {
  font-family:'Outfit',sans-serif;
  font-size:var(--fs-lbl); font-weight:400; letter-spacing:2.5px; text-transform:uppercase;
  color:var(--coral); margin-bottom:14px;
  display:flex; align-items:center; gap:10px;
}
.ph-pillar-num::after { content:''; flex:1; height:1px; background:rgba(193,107,69,0.2); max-width:40px; }
.ph-pillar-title {
  font-family:'Outfit',sans-serif;
  font-size:32px; font-weight:200; letter-spacing:-0.5px;
  color:var(--slate); line-height:1.2; margin-bottom:18px;
}
.ph-pillar-body {
  font-family:'Outfit',sans-serif;
  font-size:var(--fs-sm); font-weight:300; color:var(--slate-l); line-height:1.8; max-width:480px;
}

@media(max-width:768px) {
  .ph-nav-btn { display:none; }
  .ph-strip { padding:0 20px; }
  .ph-pillar { grid-template-columns:1fr; }
  .ph-pillar:nth-child(even) { grid-template-columns:1fr; }
  .ph-pillar-img { aspect-ratio:4/3; height:auto; }
  .ph-pillar:nth-child(even) .ph-pillar-img { order: unset; }
  .ph-pillar:nth-child(even) .ph-pillar-content { order: unset; border-left:none!important; border-right:none!important; border-top:1px solid var(--border); }
  .ph-pillar-content { padding:32px 20px; }
  .ph-pillar-title { font-size:clamp(26px,7vw,32px); margin-bottom:12px; }
  /* Mobile body-copy fix: standardize to the site's mobile body font size (var(--fs-sm)),
     matching the intro paragraph (.ph-re-sub) above. Desktop size is untouched. */
  .ph-pillar-body { font-size:var(--fs-sm); line-height:1.75; max-width:100%; }
}

  /* ---- PH BELIEFS (reference layout: header top + 5-col grid) ---- */
  .ph-beliefs { background:var(--cream); border-bottom:1px solid var(--border); }
  .ph-beliefs-header { padding:64px 56px 0; margin-bottom:0; border:none; }
  .ph-beliefs-eyebrow { display:flex; align-items:center; gap:10px; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:var(--coral); margin-bottom:16px; }
  .ph-beliefs-eyebrow::before { content:''; display:block; width:24px; height:1px; background:var(--coral); flex-shrink:0; }
  .ph-beliefs-heading { font-family:'Outfit',sans-serif; font-size:var(--fs-h1); font-weight:200; letter-spacing:-0.5px; color:var(--slate); line-height:1.2; margin:0 0 20px; }
  .ph-beliefs-desc { font-family:'Outfit',sans-serif; font-size:var(--fs-body); font-weight:300; color:var(--slate-l); line-height:1.8; max-width:520px; margin-bottom:0; padding-bottom:40px; }
  .ph-beliefs-grid { display:grid; grid-template-columns:repeat(5,1fr); border-top:1px solid var(--border); }
  .ph-bitem { padding:36px 28px 40px; border-right:1px solid var(--border); opacity:0; transform:translateY(20px); transition:opacity 0.6s ease, transform 0.6s cubic-bezier(0.22,1,0.36,1); }
  .ph-bitem:last-child { border-right:none; }
  .ph-bitem.in-view { opacity:1; transform:translateY(0); }
  .ph-bitem-num { font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; color:var(--teal); letter-spacing:2px; text-transform:uppercase; margin-bottom:16px; display:block; }
  .ph-bitem-title { font-family:'Outfit',sans-serif; font-size:var(--fs-body); font-weight:300; color:var(--slate); margin-bottom:12px; line-height:1.35; }
  .ph-bitem-desc { font-family:'Outfit',sans-serif; font-size:var(--fs-sm); font-weight:300; color:var(--slate-l); line-height:1.7; }
  @media(max-width:900px) {
    .ph-beliefs-header { padding:44px 20px 0; }
    .ph-beliefs-grid { grid-template-columns:1fr 1fr; }
    .ph-bitem { border-right:1px solid var(--border); border-bottom:1px solid var(--border); padding:28px 20px; }
    .ph-bitem:nth-child(2n) { border-right:none; }
    .ph-bitem:last-child { border-right:none; }
  }
  @media(max-width:600px) {
    .ph-beliefs-grid { grid-template-columns:1fr; }
    .ph-bitem { border-right:none; border-bottom:1px solid var(--border); padding:28px 20px; }
    .ph-bitem:last-child { border-bottom:none; }
  }

/* ---- PH AMV (AIM/MISSION/VISION) ---------------------------------------------------- */
.ph-amv { background:var(--slate); border-bottom:1px solid var(--border); padding:64px 56px; }
.ph-amv-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
.ph-amv-card { background:rgba(255,255,255,0.04); border:1px solid rgba(143,168,168,0.15); border-radius:4px; padding:32px 28px; }
.ph-amv-label { font-family:'Outfit',sans-serif; font-size:var(--fs-lbl); font-weight:300; letter-spacing:2px; text-transform:uppercase; margin-bottom:14px; }
.ph-amv-label.coral { color:var(--burnt-clay); }
.ph-amv-label.teal { color:rgba(245,240,234,0.85); }
.ph-amv-label.sage { color:rgba(255,255,255,0.65); }
.ph-amv-text { font-family:'Outfit',sans-serif; font-size:var(--fs-body); font-weight:200; color:var(--cream); line-height:1.75; }
@media(max-width:768px) {
  .ph-amv { padding:32px 20px; }
  .ph-amv-grid { grid-template-columns:1fr; gap:16px; }
}

/* ---- NP CTA (COMMUNITY) ---------------------------------------------------------------------- */
.nph-cta { background:var(--teal); border-bottom:1px solid rgba(255,255,255,0.12); margin:0; padding:0; }
.nph-cta-inner { display:grid; grid-template-columns:1.15fr 0.85fr; align-items:stretch; min-height:520px; margin:0; }
.nph-cta-inner > div:first-child { padding:72px 64px; display:flex; flex-direction:column; justify-content:center; border-right:1px solid rgba(255,255,255,0.12); }
.nph-cta-img { overflow:hidden; align-self:stretch; line-height:0; font-size:0; margin:0; padding:0; }
.nph-cta-img img { width:100%; height:100%; min-height:100%; object-fit:cover; object-position:center; display:block; vertical-align:top; margin:0; }
.nph-cta-ey { font-family:'Outfit',sans-serif; font-size:13px; font-weight:300; letter-spacing:2.5px; text-transform:uppercase; color:rgba(245,240,234,0.65); margin-bottom:22px; display:flex; align-items:center; gap:10px; }
.nph-cta-ey::before { content:''; display:block; width:24px; height:1px; background:rgba(245,240,234,0.4); flex-shrink:0; }
.nph-cta-title { font-family:'Outfit',sans-serif; font-size:clamp(30px, 3vw, 44px); font-weight:200; letter-spacing:-1px; color:white; line-height:1.15; margin-bottom:24px; }
.nph-cta-title em { font-style:italic; color:rgba(245,240,234,0.85); }
.nph-cta-body { font-family:'Outfit',sans-serif; font-size:18px; font-weight:300; color:rgba(245,240,234,0.85); line-height:1.8; margin-bottom:30px; max-width:480px; }
.nph-cta-pills { display:flex; flex-wrap:wrap; gap:10px; margin-bottom:34px; }
.nph-cta-pill { font-family:'Outfit',sans-serif; font-size:15px; font-weight:300; color:rgba(245,240,234,0.85); border:1px solid rgba(245,240,234,0.3); border-radius:100px; padding:8px 18px; }
.nph-cta-btns { display:flex; gap:14px; flex-wrap:wrap; }
.nph-cta-btn { font-family:'Outfit',sans-serif; font-size:14px; font-weight:400; letter-spacing:1.5px; text-transform:uppercase; text-decoration:none; padding:14px 28px; display:inline-flex; align-items:center; gap:8px; border-radius:2px; transition:all 0.2s; }
.nph-cta-btn.primary { background:rgba(245,240,234,0.12); color:white; border:1px solid rgba(245,240,234,0.3); }
.nph-cta-btn.primary:hover { background:rgba(245,240,234,0.2); }
.nph-cta-btn.secondary { background:transparent; color:rgba(245,240,234,0.7); border:1px solid rgba(245,240,234,0.15); }
.nph-cta-btn.secondary:hover { color:white; border-color:rgba(245,240,234,0.3); }
@media(max-width:768px) {
  .nph-cta-inner { grid-template-columns:1fr; }
  .nph-cta-inner > div:first-child { padding:32px 20px; border-right:none; border-bottom:1px solid rgba(255,255,255,0.12); }
  .nph-cta-img { height:320px; }
  .nph-cta-title { font-size:clamp(28px,8vw,36px); }
  .nph-cta-body { font-size:var(--fs-body); }
  .nph-cta-ey { font-size:var(--fs-lbl); }
}
</style>

{%- comment -%}1. PHILOSOPHY HERO{%- endcomment -%}
<section class="pg-hero">
  <div class="pg-hero-top">
    <div class="pg-hero-left">
      <div class="pg-eyebrow coral"><span class="pg-eyebrow-line"></span>How we think</div>
      <h1 class="pg-hero-title">Philosophy.</h1>
    </div>
    <div class="pg-hero-right">
      <p class="pg-hero-desc">What you buy, how you live with it, and what you become of it, it's all interconnected.</p>
    </div>
  </div>
  <!-- Hero image restored with fallback -->
  <div class="pg-hero-img">
    {% if section.settings.hero_image != blank %}
      <img src="{{ section.settings.hero_image | image_url: width: 1800 }}" alt="narkk philosophy" loading="lazy">
    {% elsif section.settings.hero_image_url != blank %}
      <img src="{{ section.settings.hero_image_url }}" alt="narkk philosophy" loading="lazy">
    {% else %}
      <img src="{{ 'Philosophy header.jpg' | asset_url }}" alt="narkk philosophy" loading="lazy">
    {% endif %}
  </div>
</section>

{%- comment -%}2. WHAT WE BELIEVE (reference: header + 5 column grid){%- endcomment -%}
<div class="ph-beliefs">
  <div class="ph-beliefs-header">
    <div class="ph-beliefs-eyebrow">What We Believe</div>
    <h2 class="ph-beliefs-heading">Five principles we don't negotiate on.</h2>
    <p class="ph-beliefs-desc">These aren't aspirations or brand values written for a pitch deck. They're the decisions we make every day &mdash; in how we design, how we price, and how we talk to you.</p>
  </div>
  <div class="ph-beliefs-grid">
    <div class="ph-bitem">
      <div class="ph-bitem-num">001</div>
      <div class="ph-bitem-body">
        <div class="ph-bitem-title">Against planned obsolescence</div>
        <div class="ph-bitem-desc">We build for the long haul. When a product reaches the end of its life, that decision belongs to the owner &mdash; not the manufacturer.</div>
      </div>
    </div>
    <div class="ph-bitem">
      <div class="ph-bitem-num">002</div>
      <div class="ph-bitem-body">
        <div class="ph-bitem-title">Modularity as Responsibility</div>
        <div class="ph-bitem-desc">Modular design isn't a feature &mdash; it's an obligation to reduce waste and extend the life of everything we make.</div>
      </div>
    </div>
    <div class="ph-bitem">
      <div class="ph-bitem-num">003</div>
      <div class="ph-bitem-body">
        <div class="ph-bitem-title">Timeless over Trend</div>
        <div class="ph-bitem-desc">In the era of chasing trends we are staying out of it. Our products are designed to belong in any decade &mdash; not in relevancy.</div>
      </div>
    </div>
    <div class="ph-bitem">
      <div class="ph-bitem-num">004</div>
      <div class="ph-bitem-body">
        <div class="ph-bitem-title">Honest Materials, Honest Price</div>
        <div class="ph-bitem-desc">Full chain accountability. We want customers to get what they pay for. The hidden costs are not for brand value but to fulfill our brand philosophy.</div>
      </div>
    </div>
    <div class="ph-bitem">
      <div class="ph-bitem-num">005</div>
      <div class="ph-bitem-body">
        <div class="ph-bitem-title">Don't buy. Choose well.</div>
        <div class="ph-bitem-desc">We are not in the business of urgency. We are not constantly trying to sell you something. We are honest in our statements for you to choose our product out of clarity, not impulsivity.</div>
      </div>
    </div>
  </div>
</div>

{%- comment -%}3. FOUNDER LETTER{%- endcomment -%}
{%- comment -%}3. FOUNDER LETTER{%- endcomment -%}
<div class="ph-founder">
  <!-- Mobile-only eyebrow, shown above the image. Hidden on desktop (eyebrow inside content is used there instead). -->
  <div class="ph-founder-ey-mobile"><span class="ph-founder-ey-line"></span>A letter from our founder</div>
  {% if section.settings.founder_image != blank %}
    <img class="ph-founder-img" src="{{ section.settings.founder_image | image_url: width: 1600 }}" alt="Founder letter">
  {% else %}
    <img class="ph-founder-img" src="{{ 'founder-pic.jpg' | asset_url }}" alt="Founder letter">
  {% endif %}
  <div class="ph-founder-grad"></div>

  <!-- Initial visible text — overlaid on image via gradient -->
  <div class="ph-founder-content">
    <div class="ph-founder-ey"><span class="ph-founder-ey-line"></span>A letter from our founder</div>
    <div class="ph-founder-sal">Dear reader,</div>
    <div class="ph-founder-body">We live in a world where it's okay to make things disposable when you could make them last. We are okay with overconsumption.</div>
    <div class="ph-founder-body">We are just fleeting moments, yet we have this self-centered greed to control, overconsume resources, not because of the need, but a want to show the world that you have the power to consume.</div>
    <div class="ph-founder-body">We weren't always like this. We used the pencil to the last inch of the lead, we collected chocolate wrappers, we used shoes till the soles were done. We didn't throw our toys; rather, we used to tinker with them.</div>
    <div class="ph-founder-body">Are we doing that anymore? I don't think we are. Impulsive buys, fast fashion, trends, virality changed consumerism into a landfill machinery. We are not emotionally attached to products anymore.</div>
    <button class="ph-founder-toggle" id="ph-founder-toggle" onclick="togglePhFounder()">Read more <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg></button>
  </div>

  <!-- Expanded text — also overlaid on image, image stretches to cover -->
  <div class="ph-founder-expand" id="ph-founder-more">
    <div class="ph-founder-expand-inner">
      <p>The formula is simple: if you are emotionally connected to a material, you will not let go of it easily. You know it's valuable, not because it's costly, but because it lasts.</p>
      <p>A good product is something that's functional, that fits your aesthetics, solves your problem, and you use it regularly, durable to wear and tear, but if it's made to last? It's not just a good product anymore. It becomes part of you, part of your healthy habits, it becomes a part of your subconscious. It's not just a good product, it's a life.</p>
      <p>In narkk, the mission is to not produce products just because we can, but because we should. We want to create products that are too proud to end up in a landfill. We believe products are created, not produced. We take pride in creation, and because of it, we want to take care of our products till their last day by facilitating returns, resale, and repairs.</p>
      <p>We don't have a strategy or plan for this brand, but an idea: we just have to create products that don't end up in a landfill, and everything will fall into place.</p>
      <div class="ph-founder-sig">
        <div class="ph-founder-sig-name">Niranjan</div>
        <div class="ph-founder-sig-title">Founder &amp; Creative Principal, narkk</div>
      </div>
    </div>
  </div>
</div>

<script>
function togglePhFounder() {
  var more = document.getElementById('ph-founder-more');
  var btn = document.getElementById('ph-founder-toggle');
  var content = document.querySelector('.ph-founder-content');
  var expandInner = document.querySelector('.ph-founder-expand-inner');
  var sig = document.querySelector('.ph-founder-sig');
  var open = more.classList.toggle('open');
  btn.classList.toggle('open', open);
  btn.childNodes[0].textContent = open ? 'Read less ' : 'Read more ';
  if (open) {
    // move the button to the end of the letter, just above the signature
    expandInner.insertBefore(btn, sig);
  } else {
    // move it back to its original spot under the intro paragraphs
    content.appendChild(btn);
  }
}
</script>

{%- comment -%}1b. THE RE-MANIFESTO INTRO + PILLAR SLIDER — fits one screen together{%- endcomment -%}
<div class="ph-manifesto-screen">
<div class="ph-re-intro">
  <div class="ph-re-ey">
    <span class="ph-re-ey-line"></span>
    The Re-Manifesto
  </div>
  <div class="ph-re-title">Every product has a next chapter.<br>We intend to be part of it.</div>
  <p class="ph-re-sub">Most things are made to be replaced. We make things to be kept. Keeping isn't just about durability; it's about what happens years later, as homes and lives change. At narkk, a product's story doesn't end at the sale. We take responsibility for the full arc, through five commitments.</p>
</div>


<div class="ph-pillars-wrap">
  <!-- Tab strip -->
  <div class="ph-strip" id="ph-strip">
    <a href="#" class="ph-strip-item active" data-idx="0">Return</a>
    <a href="#" class="ph-strip-item" data-idx="1">Restore</a>
    <a href="#" class="ph-strip-item" data-idx="2">Resale</a>
    <a href="#" class="ph-strip-item" data-idx="3">Reimagine</a>
    <a href="#" class="ph-strip-item" data-idx="4">Recycle</a>
  </div>

  <!-- Slider stage with floating arrows -->
  <div class="ph-stage-frame">
    <button class="ph-nav-btn prev" id="ph-prev" aria-label="Previous" disabled>
      <svg viewBox="0 0 24 24"><polyline points="15 5 8 12 15 19"></polyline></svg>
    </button>
    <button class="ph-nav-btn next" id="ph-next" aria-label="Next">
      <svg viewBox="0 0 24 24"><polyline points="9 5 16 12 9 19"></polyline></svg>
    </button>

    <div class="ph-pillar-stage" id="ph-pillar-stage">
      <div class="ph-pillar-track">

        <!-- Slide 1: Return — image LEFT, content RIGHT -->
        <div class="ph-pillar">
          <div class="ph-pillar-img"><img src="{{ 'return.jpg' | asset_url }}" alt="Return" loading="lazy"></div>
          <div class="ph-pillar-content">
            <div class="ph-pillar-num">(01) Return</div>
            <div class="ph-pillar-title">365 days to return.</div>
            <div class="ph-pillar-body">Sometimes you buy a product impulsively — it may have seemed necessary at that time. At narkk we promote mindful consumerism and as part of it, if you think you don't need a narkk product anymore after purchase, you can return it any time within 365 days of delivery. In the first 30 days you get your money back; after that, store credit that never expires.</div>
          </div>
        </div>

        <!-- Slide 2: Restore — even, so content LEFT, image RIGHT -->
        <div class="ph-pillar">
          <div class="ph-pillar-img"><img src="{{ 'restore.jpg' | asset_url }}" alt="Restore" loading="lazy"></div>
          <div class="ph-pillar-content">
            <div class="ph-pillar-num">(02) Restore</div>
            <div class="ph-pillar-title">Together we can bring it back.</div>
            <div class="ph-pillar-body">If something wears out, fades, or breaks — we want to know. narkk products are designed so that components can be repaired or replaced individually. No part of what we make should ever force a full replacement. We'll guide you through the fix, or do it with you.</div>
          </div>
        </div>

        <!-- Slide 3: Resale — image LEFT, content RIGHT -->
        <div class="ph-pillar">
          <div class="ph-pillar-img"><img src="{{ 'ph-resale-new.jpg' | asset_url }}" alt="Resale" loading="lazy"></div>
          <div class="ph-pillar-content">
            <div class="ph-pillar-num">(03) Resale</div>
            <div class="ph-pillar-title">Good things deserve a second home.</div>
            <div class="ph-pillar-body">A narkk product that no longer fits your space shouldn't disappear — it should find someone who needs it. We actively support resale within our community and will help connect sellers with buyers. Objects built to last are worth passing on.</div>
          </div>
        </div>

        <!-- Slide 4: Reimagine — even, content LEFT, image RIGHT -->
        <div class="ph-pillar">
          <div class="ph-pillar-img"><img src="{{ 'Reimagine.jpg' | asset_url }}" alt="Reimagine" loading="lazy"></div>
          <div class="ph-pillar-content">
            <div class="ph-pillar-num">(04) Reimagine</div>
            <div class="ph-pillar-title">Make it something new.</div>
            <div class="ph-pillar-body">Modularity means your narkk product can change with you — rearranged, repurposed, reconfigured for a new room, a new need, a new chapter. We'll share ideas, guides, and community stories on how people are reimagining what they already own instead of buying something new.</div>
          </div>
        </div>

        <!-- Slide 5: Recycle — image LEFT, content RIGHT -->
        <div class="ph-pillar">
          <div class="ph-pillar-img"><img src="{{ 'ph-recycle-new.jpg' | asset_url }}" alt="Recycle" loading="lazy"></div>
          <div class="ph-pillar-content">
            <div class="ph-pillar-num">(05) Recycle</div>
            <div class="ph-pillar-title">When it's truly done, we close the loop.</div>
            <div class="ph-pillar-body">If a narkk product reaches the genuine end of its usable life, we take responsibility for what comes next. We work to ensure materials are broken down responsibly — not dumped. A landfill is never the answer, and we don't design products that quietly accept it as one.</div>
          </div>
        </div>

      </div><!-- /ph-pillar-track -->
    </div><!-- /ph-pillar-stage -->
  </div><!-- /ph-stage-frame -->
</div><!-- /ph-pillars-wrap -->
</div><!-- /ph-manifesto-screen -->

  


{%- comment -%}5. OUR AIM / MISSION / VISION{%- endcomment -%}
<div class="ph-amv">
  <div class="ph-amv-grid">
    <div class="ph-amv-card">
      <div class="ph-amv-label coral">Our Aim</div>
      <div class="ph-amv-text">To prove that a fairly priced, honestly made, modular furniture brand can sustain with a community to back it against the ideology of fast furniture brands.</div>
    </div>
    <div class="ph-amv-card">
      <div class="ph-amv-label teal">Our Mission</div>
      <div class="ph-amv-text">Not greenwashing mass production but actually making products that don't end up in a landfill. Modular by design, repairable by intent. Standing against planned obsolescence not with words but with how the product is made.</div>
    </div>
    <div class="ph-amv-card">
      <div class="ph-amv-label sage">Our Vision</div>
      <div class="ph-amv-text">A self-sustaining space where thinkers, collaborators, and designers walk in and create products that contribute to humanity. A caf where people eat, learn to restore, bring damaged products for repair, and buy narkk products. A living, breathing proof of the philosophy.</div>
    </div>
  </div>
</div>

