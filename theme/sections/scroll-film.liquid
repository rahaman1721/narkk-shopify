<style>
/* ------ SCROLL FILM ANIMATION ------ */
.sf-section {
  position: relative;
  height: 600vh;
  background: #0a0a0a;
}
.sf-sticky {
  position: sticky;
  top: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}
.sf-canvas {
  width: 100%;
  height: 100%;
  display: block;
}
.sf-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 60px;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 55%);
  pointer-events: none;
}
.sf-label {
  font-family: 'Outfit', sans-serif;
  font-size: 11px;
  font-weight: 300;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  margin-bottom: 14px;
  opacity: 0;
  transform: translateY(10px);
  transition: opacity 0.6s ease, transform 0.6s ease;
}
.sf-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(32px, 5vw, 68px);
  font-weight: 200;
  letter-spacing: -2px;
  color: white;
  line-height: 1.05;
  max-width: 580px;
  opacity: 0;
  transform: translateY(14px);
  transition: opacity 0.65s 0.1s ease, transform 0.65s 0.1s ease;
}
.sf-label.sf-show, .sf-title.sf-show {
  opacity: 1;
  transform: translateY(0);
}
.sf-bar {
  position: absolute;
  bottom: 0; left: 0;
  height: 2px;
  width: 0%;
  background: var(--burnt-clay);
}
.sf-loading {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a0a0a;
  transition: opacity 0.5s;
}
.sf-loading-ring {
  width: 36px; height: 36px;
  border: 1px solid rgba(255,255,255,0.15);
  border-top-color: var(--burnt-clay);
  border-radius: 50%;
  animation: sf-spin 0.9s linear infinite;
}
@keyframes sf-spin { to { transform: rotate(360deg); } }

@media (max-width: 768px) {
  .sf-overlay { padding: 32px 20px; }
  .sf-section { height: 450vh; }
}
</style>

<section class="sf-section" id="sf-section">
  <div class="sf-sticky">
    <canvas class="sf-canvas" id="sf-canvas"></canvas>

    <div class="sf-overlay">
      <div class="sf-label" id="sf-label">{{ section.settings.eyebrow | default: 'Tulai &mdash; Pegboard System' }}</div>
      <div class="sf-title" id="sf-title">{{ section.settings.title | default: 'Crafted to last a lifetime.' }}</div>
    </div>

    <div class="sf-bar" id="sf-bar"></div>

    <div class="sf-loading" id="sf-loading">
      <div class="sf-loading-ring"></div>
    </div>
  </div>
</section>

<script>
(function () {
  /* ---- Frame URLs &mdash; generated by Liquid ---- */
  var FRAMES = [
    {%- for i in (1..196) -%}
      {%- assign pad = i | prepend: '000' | slice: -3, 3 -%}
      {%- assign fname = 'scroll-frame-' | append: pad | append: '.jpg' -%}
      {{ fname | asset_url | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  var FRAME_COUNT = FRAMES.length;
  var canvas   = document.getElementById('sf-canvas');
  var ctx      = canvas ? canvas.getContext('2d') : null;
  var section  = document.getElementById('sf-section');
  var bar      = document.getElementById('sf-bar');
  var label    = document.getElementById('sf-label');
  var title    = document.getElementById('sf-title');
  var loading  = document.getElementById('sf-loading');

  if (!canvas || !ctx || !section) return;

  var images  = new Array(FRAME_COUNT);
  var loadedCount = 0;
  var currentFrame = 0;
  var ticking = false;

  /* ---- Canvas sizing ---- */
  function resize() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
    draw(currentFrame);
  }
  resize();
  window.addEventListener('resize', resize);

  /* ---- Draw a frame ---- */
  function draw(idx) {
    var img = images[idx];
    if (!img || !img.complete || !img.naturalWidth) return;
    var cw = canvas.width, ch = canvas.height;
    var scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
    var sw = img.naturalWidth  * scale;
    var sh = img.naturalHeight * scale;
    ctx.clearRect(0, 0, cw, ch);
    ctx.drawImage(img, (cw - sw) / 2, (ch - sh) / 2, sw, sh);
  }

  /* ---- Preload frames ---- */
  function loadOne(idx) {
    var img = new Image();
    img.onload = function () {
      images[idx] = img;
      loadedCount++;
      if (loadedCount === 1) {
        draw(0);
        if (loading) { loading.style.opacity = '0'; setTimeout(function(){ loading.style.display='none'; }, 500); }
      }
    };
    img.src = FRAMES[idx];
  }

  /* Load frame 0 first, then queue the rest */
  loadOne(0);
  for (var i = 1; i < FRAME_COUNT; i++) { loadOne(i); }

  /* ---- Scroll handler ---- */
  window.addEventListener('scroll', function () {
    if (!ticking) {
      requestAnimationFrame(function () {
        var rect     = section.getBoundingClientRect();
        var scrollH  = section.offsetHeight - window.innerHeight;
        var frac     = Math.max(0, Math.min(1, -rect.top / scrollH));
        var idx      = Math.min(FRAME_COUNT - 1, Math.floor(frac * FRAME_COUNT));

        if (idx !== currentFrame) { currentFrame = idx; draw(idx); }

        if (bar)  bar.style.width = (frac * 100) + '%';

        var showText = frac > 0.08 && frac < 0.88;
        if (label) label.classList.toggle('sf-show', showText);
        if (title) title.classList.toggle('sf-show', showText);

        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });

})();
</script>

{% schema %}
{
  "name": "Scroll Film",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow Text", "default": "Tulai \u2014 Pegboard System" },
    { "type": "textarea", "id": "title", "label": "Heading", "default": "Crafted to last a lifetime." }
  ],
  "presets": [{ "name": "Scroll Film" }]
}
{% endschema %}
